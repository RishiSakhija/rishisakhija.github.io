---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="404 | Rishi Sakhija" description="Page not found.">

  <!-- Page Header Band -->
  <header class="page-header" aria-hidden="true">
    <div class="container">
      <nav class="page-header__breadcrumb" aria-label="Breadcrumb">
        <span>HOME</span>
        <span aria-hidden="true">/</span>
        <span>404</span>
      </nav>
      <div class="page-header__number">01</div>
      <h1 class="page-header__title">Not Found</h1>
    </div>
  </header>

  <section class="section error-section" aria-labelledby="error-title">
    <div class="container">
      <div class="error-content reveal-target">
        <div class="error__code" aria-hidden="true">404</div>
        <h1 id="error-title" class="error__title">Route not found</h1>
        <p class="error__desc">
          The path you requested doesn't exist in this control room.
          <br />
          <span class="error__hint">> check your coordinates</span>
        </p>
        <Button variant="primary" href="/">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          Return to Home
        </Button>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Page Header Band */
  .page-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    margin-bottom: calc(var(--section-padding) - var(--space-6));
  }

  .page-header__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .page-header__breadcrumb span:not([aria-hidden]) {
    color: var(--text-fade);
  }

  .page-header__number {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--signal);
    margin-bottom: var(--space-1);
  }

  .page-header__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    background: linear-gradient(90deg, var(--text), var(--text-fade));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .error-section {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .error-content {
    text-align: center;
    max-width: 400px;
    margin: 0 auto;
  }

  .error__code {
    font-family: var(--font-mono);
    font-size: clamp(6rem, 20vw, 12rem);
    font-weight: 700;
    line-height: 1;
    color: var(--signal);
    opacity: 0.3;
    margin-bottom: var(--space-4);
  }

  .error__title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    margin-bottom: var(--space-4);
  }

  .error__desc {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-fade);
    margin-bottom: var(--space-8);
  }

  .error__hint {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    display: block;
    margin-top: var(--space-3);
  }
</style>