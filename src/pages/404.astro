---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="404 | Rishi Sakhija" description="Page not found.">

  <section class="section error-section" aria-labelledby="error-title">
    <div class="container">
      <div class="error-content reveal-target">
        <div class="error__code" aria-hidden="true">404</div>
        <h1 id="error-title" class="error__title">Route not found</h1>
        <p class="error__desc">
          The path you requested doesn't exist in this control room.
          <br />
          <span class="error__hint">> check your coordinates</span>
        </p>
        <Button variant="primary" href="/">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          Return to Home
        </Button>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .error-section {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .error-content {
    text-align: center;
    max-width: 400px;
    margin: 0 auto;
  }

  .error__code {
    font-family: var(--font-mono);
    font-size: clamp(6rem, 20vw, 12rem);
    font-weight: 700;
    line-height: 1;
    color: var(--red);
    opacity: 0.3;
    margin-bottom: var(--space-4);
  }

  .error__title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    margin-bottom: var(--space-4);
  }

  .error__desc {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-fade);
    margin-bottom: var(--space-8);
  }

  .error__hint {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--blue-soft);
    display: block;
    margin-top: var(--space-3);
  }
</style>