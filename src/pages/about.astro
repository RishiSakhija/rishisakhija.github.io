---
import BaseLayout from '../layouts/BaseLayout.astro';
import HudCard from '../components/HudCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Chip from '../components/Chip.astro';
import Button from '../components/Button.astro';
import StatusDot from '../components/StatusDot.astro';
import RSLogo from '../components/RSLogo.astro';
import { aboutData } from '../data/about.js';
---

<BaseLayout title="About | Rishi Sakhija" description="Self-taught AI/ML builder and Computer Engineering diploma student focused on agents, automation and search systems.">

  <!-- HEADER BAND -->
  <header class="page-header" aria-hidden="true">
    <div class="container">
      <nav class="page-header__breadcrumb" aria-label="Breadcrumb">
        <span>HOME</span>
        <span aria-hidden="true">/</span>
        <span>ABOUT</span>
      </nav>
      <h1 class="page-header__title heading-gradient">Learning in public, building for real.</h1>
      <p class="page-header__intro">{aboutData.intro}</p>
    </div>
  </header>

  <!-- 01 MY STORY -->
  <section class="section" aria-labelledby="story-title">
    <div class="container">
      <SectionHeader number="01" label="Profile" title="My Story" id="story-title" tag="MY STORY" />

      <div class="story-grid">
        <!-- LEFT: Portrait Card -->
        <aside class="story-portrait reveal-target">
          <HudCard class="portrait-card">
            <div class="portrait-monogram">
              <RSLogo size={140} />
            </div>
            <h2 class="portrait-name">Rishi Sakhija</h2>
            <p class="portrait-role">AI/ML builder · Agents & Automation</p>

            <div class="portrait-facts">
              {aboutData.facts.map((fact, i) => (
                <div class="portrait-fact">
                  <span class="portrait-fact__label">{fact.label}</span>
                  <span class="portrait-fact__value">
                    {fact.dot ? <StatusDot status="live" label={fact.value} /> : fact.value}
                  </span>
                  {i < aboutData.facts.length - 1 && <div class="portrait-fact__divider" aria-hidden="true" />}
                </div>
              ))}
            </div>
          </HudCard>
        </aside>

        <!-- RIGHT: Story Chapters -->
        <div class="story-chapters">
          {aboutData.chapters.map((chapter, i) => (
            <article class="story-chapter reveal-target">
              <div class="story-chapter__meta">
                <span class="story-chapter__number">{chapter.number}</span>
                <h3 class="story-chapter__title">{chapter.title}</h3>
              </div>
              <div class="story-chapter__content">
                {chapter.paragraphs.map(p => <p>{p}</p>)}
              </div>
              {i < aboutData.chapters.length - 1 && <div class="story-chapter__divider" aria-hidden="true" />}
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 02 HOW I WORK -->
  <section class="section" aria-labelledby="principles-title">
    <div class="container">
      <SectionHeader number="02" label="Method" title="How I Work" id="principles-title" />

      <div class="principles-grid">
        {aboutData.principles.map(principle => (
          <article class="reveal-target">
            <HudCard>
              <div class="principle-card">
                <span class="principle-card__number">{principle.number}</span>
                <h3 class="principle-card__title">{principle.title}</h3>
                <p class="principle-card__desc">{principle.description}</p>
              </div>
            </HudCard>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 TIMELINE -->
  <section class="section" aria-labelledby="timeline-title">
    <div class="container">
      <SectionHeader number="03" label="History" title="Timeline" id="timeline-title" />

      <div class="timeline">
        {aboutData.timeline.map((entry, i) => (
          <article class="timeline-item reveal-target">
            <HudCard class="timeline-card">
              <div class="timeline-card__header">
                <div>
                  <h3 class="timeline-card__title">{entry.title}</h3>
                  <p class="timeline-card__subtitle">{entry.subtitle}</p>
                </div>
                <span class="timeline-card__period">{entry.period}</span>
              </div>
              <p class="timeline-card__desc">{entry.description}</p>
            </HudCard>
            {i < aboutData.timeline.length - 1 && <div class="timeline-connector" aria-hidden="true" />}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 WHAT I'M LOOKING FOR -->
  <section class="section" aria-labelledby="looking-title">
    <div class="container">
      <SectionHeader number="04" label="Future" title="What I'm Looking For" id="looking-title" />

      <div class="looking-grid">
        {aboutData.looking.map(item => (
          <article class="reveal-target">
            <HudCard>
              <h3 class="looking-card__title">{item.title}</h3>
              <p class="looking-card__desc">{item.description}</p>
            </HudCard>
          </article>
        ))}
      </div>

      <div class="looking-status reveal-target">
        <StatusDot status="live" label="Open to work · Remote" />
      </div>
    </div>
  </section>

  <!-- 05 CURRENTLY LEARNING -->
  <section class="section" aria-labelledby="learning-title">
    <div class="container">
      <SectionHeader number="05" label="Growth" title="Currently Learning" id="learning-title" />

      <div class="learning-card reveal-target">
        <HudCard>
          <div class="learning-chips">
            {aboutData.learning.map(topic => <Chip>{topic}</Chip>)}
          </div>
          <p class="learning-description">{aboutData.learningDescription}</p>
        </HudCard>
      </div>
    </div>
  </section>

  <!-- OPTIONAL: BEYOND THE CODE -->
  {aboutData.beyond.length > 0 && (
    <section class="section" aria-labelledby="beyond-title">
      <div class="container">
        <SectionHeader number="06" label="Extra" title="Beyond the Code" id="beyond-title" />
        <div class="beyond-grid">
          {aboutData.beyond.map(item => (
            <article class="reveal-target">
              <HudCard>{item}</HudCard>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {aboutData.strengths.length > 0 && (
    <section class="section" aria-labelledby="strengths-title">
      <div class="container">
        <SectionHeader number="07" label="Self" title="Strengths" id="strengths-title" />
        <div class="strengths-chips reveal-target">
          <HudCard>
            <div class="strengths-chip-group">
              {aboutData.strengths.map(s => <Chip>{s}</Chip>)}
            </div>
          </HudCard>
        </div>
      </div>
    </section>
  )}

  <!-- CLOSING CTA -->
  <section class="section cta-section" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta-content reveal-target">
        <h2 id="cta-title" class="cta__title heading-gradient">Let's talk.</h2>
        <p class="cta__subtitle">Open to opportunities, collaborations, and conversations about AI.</p>
        <div class="cta__actions">
          <Button
            variant="primary"
            id="copy-email-btn"
            class="js-only"
            type="button"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            Copy email
          </Button>
          <Button variant="secondary" href="https://github.com/RishiSakhija" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </Button>
          <Button variant="secondary" href="https://www.linkedin.com/in/rishisakhija" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </Button>
          {/* <Button variant="secondary" href="/resume.pdf" target="_blank" rel="noopener noreferrer">Resume</Button> */}
        </div>
        <p class="cta__email">rishisakhija7@gmail.com</p>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // Copy email button
  (() => {
    const btn = document.getElementById('copy-email-btn');
    if (!btn) return;

    async function copyEmail() {
      const email = 'rishisakhija7@gmail.com';
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(email);
        } else {
          const textarea = document.createElement('textarea');
          textarea.value = email;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
        }
        const originalText = btn.innerHTML;
        btn.innerHTML = `
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Copied
        `;
        setTimeout(() => {
          btn.innerHTML = originalText;
        }, 2000);
      } catch (e) {
        // fallback mailto link handles it
      }
    }

    btn.addEventListener('click', copyEmail);
  })();
</script>

<style>
  /* HEADER BAND */
  .page-header {
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    padding-top: clamp(120px, 14vw, 160px);
  }

  .page-header__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .page-header__breadcrumb span:not([aria-hidden]) {
    color: var(--text-fade);
  }

  .page-header__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .page-header__intro {
    font-size: 18px;
    line-height: 1.75;
    font-weight: 500;
    color: var(--text-body);
    max-width: 64ch;
    margin-top: var(--space-4);
  }

  /* ============================================================
     01 MY STORY
     ============================================================ */

  .story-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .story-grid {
      grid-template-columns: 36% 64%;
      align-items: start;
    }
  }

  /* Portrait Card */
  .story-portrait {
    position: relative;
  }

  @media (min-width: 1024px) {
    .story-portrait {
      position: sticky;
      top: 120px;
    }
  }

  .portrait-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-8);
  }

  .portrait-monogram {
    position: relative;
    margin-bottom: var(--space-5);
  }

  .portrait-monogram::before {
    content: '';
    position: absolute;
    inset: -30px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(77, 124, 255, 0.18), transparent);
    z-index: -1;
    pointer-events: none;
  }

  .portrait-name {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    color: var(--text);
    margin-bottom: var(--space-1);
  }

  .portrait-role {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--signal-soft);
    margin-bottom: var(--space-6);
  }

  .portrait-facts {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    max-width: 320px;
  }

  .portrait-fact {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .portrait-fact:first-child {
    border-top: 1px solid var(--border);
  }

  .portrait-fact__label {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-strong);
  }

  .portrait-fact__value {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    text-align: right;
  }

  .portrait-fact__divider {
    /* divider handled by border on .portrait-fact */
  }

  @media (max-width: 1023px) {
    .story-portrait {
      position: static;
    }
  }

  /* Story Chapters */
  .story-chapters {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .story-chapter {
    padding-bottom: var(--space-8);
  }

  .story-chapter:last-child {
    padding-bottom: 0;
  }

  .story-chapter__meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .story-chapter__number {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal-soft);
    flex-shrink: 0;
  }

  .story-chapter__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.2;
    color: var(--text);
  }

  .story-chapter__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .story-chapter__content p {
    font-size: 17.5px;
    line-height: 1.75;
    font-weight: 500;
    color: var(--text-body);
    max-width: 62ch;
    margin: 0;
  }

  .story-chapter__divider {
    height: 1px;
    background: var(--border);
    margin-top: var(--space-8);
  }

  @media (max-width: 1023px) {
    .story-portrait {
      position: static;
    }
  }

  /* ============================================================
     02 HOW I WORK
     ============================================================ */

  .principles-grid {
    display: grid;
    gap: var(--card-gap);
  }

  @media (min-width: 768px) {
    .principles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .principle-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .principle-card__number {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal-soft);
  }

  .principle-card__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.3;
    color: var(--text);
  }

  .principle-card__desc {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-body);
  }

  /* ============================================================
     03 TIMELINE
     ============================================================ */

  .timeline {
    position: relative;
    padding-left: 24px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, transparent, var(--signal), transparent);
  }

  .timeline-item {
    position: relative;
    padding-bottom: var(--space-10);
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-connector {
    position: absolute;
    left: -24px;
    top: 60px;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, transparent, var(--signal), transparent);
    z-index: -1;
  }

  .timeline-card {
    padding: var(--card-padding);
  }

  .timeline-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .timeline-card__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.3;
    color: var(--text);
  }

  .timeline-card__subtitle {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-strong);
    margin-top: var(--space-1);
  }

  .timeline-card__period {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal-soft);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .timeline-card__desc {
    font-size: 16px;
    line-height: 1.65;
    font-weight: 500;
    color: var(--text-body);
  }

  /* ============================================================
     04 WHAT I'M LOOKING FOR
     ============================================================ */

  .looking-grid {
    display: grid;
    gap: var(--card-gap);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 768px) {
    .looking-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .looking-card__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.3;
    color: var(--text);
    margin-bottom: var(--space-3);
  }

  .looking-card__desc {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-body);
  }

  .looking-status {
    text-align: center;
  }

  /* ============================================================
     05 CURRENTLY LEARNING
     ============================================================ */

  .learning-card {
    max-width: 100%;
  }

  .learning-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .learning-description {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-body);
  }

  /* ============================================================
     CLOSING CTA
     ============================================================ */

  .cta-section {
    border-top: 1px solid var(--border);
    padding-top: var(--space-8);
  }

  .cta-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .cta__title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    margin-bottom: var(--space-4);
  }

  .cta__subtitle {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-body);
    margin-bottom: var(--space-8);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .cta__email {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text-fade);
  }

  /* ============================================================
     REVEAL ANIMATION (gentle fade-up, never hides without JS)
     ============================================================ */

  .reveal-target {
    opacity: 1;
    transform: none;
  }

  .html.js .reveal-target {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .html.js .reveal-target.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .html.js .reveal-target {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>