---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience } from '../data/experience';
import { education } from '../data/education';
import { skillGroups } from '../data/skills';
import Chip from '../components/ui/Chip.astro';
import SectionNumber from '../components/ui/SectionNumber.astro';
---

<BaseLayout
  title="About"
  description="Rishi Sakhija — self-taught AI/ML engineer focused on agents, automation, and the agentic era. Learning in public, building for real."
>
  <section class="about-page" aria-labelledby="about-heading">
    <div class="container">
      <header class="about-intro reveal">
        <SectionNumber number={1} label="ABOUT" />
        <h1 id="about-heading" class="about-intro-title">Learning in public, building for real.</h1>
        <p class="about-intro-text">
          I'm Rishi Sakhija, a Computer Engineering diploma student and a self-taught builder with over 2.5 years of hands-on work in AI and machine learning. My focus is the agentic era: systems that reason, coordinate, and act. I learn by building, and everything here is real work in progress.
        </p>
        <p class="about-intro-text mono" style="margin-top: var(--space-lg);">
          Location: Remote
        </p>
      </header>

      <div class="about-details">
        <section aria-labelledby="experience-heading">
          <SectionNumber number={2} label="EXPERIENCE" />
          <h2 id="experience-heading" class="about-section-title">Experience</h2>
          <div class="timeline" role="list">
            {experience.map((item) => (
              <article class="timeline-item" role="listitem">
                <time class="timeline-date" datetime={item.period}>{item.period}</time>
                <h3 class="timeline-role">{item.role}</h3>
                <p class="timeline-company">{item.company}</p>
                <p class="timeline-description">{item.description}</p>
              </article>
            ))}
          </div>
        </section>

        <section aria-labelledby="education-heading">
          <SectionNumber number={3} label="EDUCATION" />
          <h2 id="education-heading" class="about-section-title">Education</h2>
          <div class="timeline" role="list">
            {education.map((item) => (
              <article class="timeline-item" role="listitem">
                <time class="timeline-date" datetime={item.period}>{item.period}</time>
                <h3 class="timeline-role">{item.degree}</h3>
                <p class="timeline-company">{item.institution}</p>
                <p class="timeline-description">Status: {item.status}</p>
              </article>
            ))}
          </div>
        </section>

        <section aria-labelledby="skills-heading">
          <SectionNumber number={4} label="SKILLS" />
          <h2 id="skills-heading" class="about-section-title">Skills</h2>
          <div class="skill-groups">
            {skillGroups.map((group, index) => (
              <section class="skill-group reveal" style={`--delay: ${index + 1}`}>
                <h3 class="skill-group-label">{group.category}</h3>
                <div class="skill-chips" role="list" aria-label={`${group.category} skills`}>
                  {group.skills.map((skill) => (
                    <Chip role="listitem">{skill}</Chip>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </section>
      </div>

      <div class="about-grid" style="margin-top: var(--space-3xl);">
        <article class="placeholder-section reveal" aria-labelledby="blog-placeholder">
          <h2 id="blog-placeholder" class="placeholder-title">Blog</h2>
          <p class="placeholder-text">Coming soon — technical deep-dives, project retrospectives, and lessons learned while building in public.</p>
        </article>
        <article class="placeholder-section reveal" aria-labelledby="proof-placeholder">
          <h2 id="proof-placeholder" class="placeholder-title">Proof of Work</h2>
          <p class="placeholder-text">Coming soon — verified contributions, certifications, and tangible evidence of skills in action.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>