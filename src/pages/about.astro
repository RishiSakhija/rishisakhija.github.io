---
import BaseLayout from '../layouts/BaseLayout.astro';
import HudCard from '../components/HudCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatusDot from '../components/StatusDot.astro';
---

<BaseLayout title="About | Rishi Sakhija" description="AI/ML builder focused on agents, automation, and search systems. Self-taught, remote, open to work.">

  <!-- Page Header Band -->
  <header class="page-header" aria-hidden="true">
    <div class="container">
      <nav class="page-header__breadcrumb" aria-label="Breadcrumb">
        <span>HOME</span>
        <span aria-hidden="true">/</span>
        <span>ABOUT</span>
      </nav>
      <div class="page-header__number">01</div>
      <h1 class="page-header__title">About</h1>
    </div>
  </header>

  <section class="section" aria-labelledby="bio-title">
    <div class="container">
      <SectionHeader number="02" label="Profile" title="About Me" id="bio-title" />

      <div class="about__bio reveal-target">
        <HudCard>
          <p>I'm Rishi Sakhija, a Computer Engineering diploma student and a self-taught builder with over 2.5 years of hands-on work in AI and machine learning.</p>
          <p>My focus is the agentic era: systems that reason, coordinate, and act. I learn by building, and everything here is real work in progress.</p>
        </HudCard>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="timeline-title">
    <div class="container">
      <SectionHeader number="03" label="History" title="Timeline" id="timeline-title" />

      <div class="timeline">
        <article class="timeline__item reveal-target">
          <HudCard>
            <div class="timeline__header">
              <div>
                <h3 class="timeline__role">Independent Builder</h3>
                <p class="timeline__org">Self-directed</p>
              </div>
              <span class="timeline__period">~2.5 years</span>
            </div>
            <p class="timeline__desc">AI, ML, agents, automation — building, breaking, and learning in public.</p>
          </HudCard>
        </article>

        <article class="timeline__item reveal-target">
          <HudCard>
            <div class="timeline__header">
              <div>
                <h3 class="timeline__role">Diploma in Computer Engineering</h3>
                <p class="timeline__org">Currently 5th semester</p>
              </div>
              <span class="timeline__period">Present</span>
            </div>
            <p class="timeline__desc">Formal education alongside hands-on AI/ML work.</p>
          </HudCard>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="facts-title">
    <div class="container">
      <SectionHeader number="04" label="System" title="Facts" id="facts-title" />

      <div class="facts-grid">
        <div class="reveal-target">
          <HudCard label="LOCATION">
            <div class="status-item">
              <StatusDot status="live" label="Remote" />
            </div>
          </HudCard>
        </div>
        <div class="reveal-target">
          <HudCard label="AVAILABILITY">
            <div class="status-item">
              <StatusDot status="live" label="Open to work" />
            </div>
          </HudCard>
        </div>
        <div class="reveal-target">
          <HudCard label="EDUCATION">
            <div class="fact-readout">
              <span class="fact-readout__value">Diploma</span>
              <span class="fact-readout__label">Computer Engineering · 5th semester</span>
            </div>
          </HudCard>
        </div>
        <div class="reveal-target">
          <HudCard label="EXPERIENCE">
            <div class="fact-readout">
              <span class="fact-readout__value">2.5+ yrs</span>
              <span class="fact-readout__label">Self-taught AI/ML hands-on</span>
            </div>
          </HudCard>
        </div>
        <div class="reveal-target">
          <HudCard label="FOCUS">
            <div class="fact-readout">
              <span class="fact-readout__value">Agentic era</span>
              <span class="fact-readout__label">Agents, automation, search</span>
            </div>
          </HudCard>
        </div>
        <div class="reveal-target">
          <HudCard label="APPROACH">
            <div class="fact-readout">
              <span class="fact-readout__value">Build first</span>
              <span class="fact-readout__label">Learn by doing, share in public</span>
            </div>
          </HudCard>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Page Header Band */
  .page-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    margin-bottom: calc(var(--section-padding) - var(--space-6));
  }

  .page-header__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .page-header__breadcrumb span:not([aria-hidden]) {
    color: var(--text-fade);
  }

  .page-header__number {
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
    margin-bottom: var(--space-1);
  }

  .page-header__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    background: linear-gradient(90deg, var(--text), var(--text-fade));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .about__bio {
    max-width: 800px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--card-gap);
  }

  .timeline__item {
    position: relative;
  }

  .timeline__item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 60px;
    bottom: -24px;
    width: 1px;
    background: var(--border);
  }

  @media (min-width: 768px) {
    .timeline__item:not(:last-child)::before {
      left: calc(var(--card-padding) + 20px);
    }
  }

  .timeline__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .timeline__role {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.125rem;
    color: var(--text);
  }

  .timeline__org {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: var(--space-1);
  }

  .timeline__period {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .timeline__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .facts-grid {
    display: grid;
    gap: var(--card-gap);
  }

  @media (min-width: 768px) {
    .facts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .facts-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .fact-readout {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .fact-readout__value {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    color: var(--text);
  }

  .fact-readout__label {
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .status-grid {
    display: grid;
    gap: var(--card-gap);
  }

  @media (min-width: 768px) {
    .status-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .status-item {
    display: flex;
    align-items: center;
  }
</style>