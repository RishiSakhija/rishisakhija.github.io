---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HudCard from '../../components/HudCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Chip from '../../components/Chip.astro';
import StatusDot from '../../components/StatusDot.astro';
import ProjectDiagram from '../../components/ProjectDiagram.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { projects, getPrevNext, getProject } from '../../data/projects.js';

export function getStaticPaths() {
  return projects.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getProject(slug as string);
const { prev, next } = getPrevNext(slug as string);

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}

// Helper to check if section should render
const hasScreenshots = project.screenshots && project.screenshots.length > 0;
const hasSteps = project.steps && project.steps.length > 0;
const hasArchitecture = project.architecture && project.architecture.length > 0;
const hasAgents = project.agents && project.agents.length > 0;
const hasPrinciples = project.principles && project.principles.length > 0;
const hasLedger = project.ledger && project.ledger.length > 0;
const hasTech = project.tech && project.tech.length > 0;
const hasRoadmap = project.roadmap && project.roadmap.length > 0;
const hasNextSteps = project.nextSteps && project.nextSteps.length > 0;
const hasLearned = project.learned && project.learned.trim().length > 0;
const hasProblem = project.problem && (project.problem.intro || (project.problem.points && project.problem.points.length > 0));
const hasBoundaries = project.boundaries && (project.boundaries.title || (project.boundaries.items && project.boundaries.items.length > 0));
const hasPlainWords = project.plainWords && project.plainWords.trim().length > 0;
const hasSummary = project.summary && project.summary.length > 0;
const hasGoal = project.goal && project.goal.trim().length > 0;
const hasTagline = project.tagline && project.tagline.trim().length > 0;
const hasFacts = project.facts && project.facts.length > 0;
const hasSubtitle = project.subtitle && project.subtitle.trim().length > 0;
const hasStatusNote = project.statusNote && project.statusNote.trim().length > 0;

// Dynamic section numbering
let sectionCounter = 0;
function nextSection() { return `0${++sectionCounter}`.slice(-2); }

// Build ordered list of sections that will actually render
const sectionOrder = [
  'overview',
  'problem',
  'how-it-works',
  'agents',
  'principles',
  'ledger',
  'tech',
  'roadmap',
  'screenshots',
  'learned'
].filter(name => {
  switch (name) {
    case 'overview': return hasSummary || hasPlainWords || hasGoal;
    case 'problem': return hasProblem || hasBoundaries;
    case 'how-it-works': return hasSteps || hasArchitecture;
    case 'agents': return hasAgents;
    case 'principles': return hasPrinciples;
    case 'ledger': return hasLedger;
    case 'tech': return hasTech;
    case 'roadmap': return hasRoadmap || hasNextSteps;
    case 'screenshots': return hasScreenshots;
    case 'learned': return hasLearned;
    default: return false;
  }
});

function getSectionNumber(name: string) {
  const idx = sectionOrder.indexOf(name);
  return idx >= 0 ? `0${idx + 1}`.slice(-2) : '??';
}

// Find CEO agent
const ceoAgent = project.agents?.find(a => a.name.toLowerCase().includes('ceo'));
const otherAgents = project.agents?.filter(a => !a.name.toLowerCase().includes('ceo')) || [];

// Check if all tech items are planned
const allTechPlanned = hasTech && project.tech.every(t => t.state === 'planned');

// State badge inline renderer
function renderStateBadge(state?: string) {
  if (!state) return '';
  if (state === 'planned') return '<span class="state-badge state-badge--planned">PLANNED</span>';
  if (state === 'done') return '<span class="state-badge state-badge--done">DONE</span>';
  if (state === 'current' || state === 'next') return `<span class="state-badge state-badge--current">${state === 'current' ? 'CURRENT' : 'NEXT'}</span>`;
  return '';
}

// Timeline dot inline renderer
function renderTimelineDot(state?: string) {
  if (!state) return '<span class="timeline-dot timeline-dot--planned"></span>';
  if (state === 'done') return '<span class="timeline-dot timeline-dot--done"></span>';
  if (state === 'current' || state === 'next') return '<span class="timeline-dot timeline-dot--current"></span>';
  return '<span class="timeline-dot timeline-dot--planned"></span>';
}
---

<BaseLayout 
  title={`${project.name} | Projects | Rishi Sakhija`} 
  description={project.tagline || project.summary?.[0] || project.plainWords}
>

  <!-- HEADER BAND -->
  <header class="page-header" aria-hidden="true">
    <div class="container">
      <nav class="page-header__breadcrumb" aria-label="Breadcrumb">
        <span>HOME</span>
        <span aria-hidden="true">/</span>
        <span>PROJECTS</span>
        <span aria-hidden="true">/</span>
        <span>{project.name.toUpperCase()}</span>
      </nav>
      <h1 class="page-header__title heading-gradient">{project.name}</h1>
      {hasSubtitle && (
        <p class="page-header__subtitle">{project.subtitle}</p>
      )}
    </div>
  </header>

  <!-- PROJECT HEADER -->
  <section class="section project-header-section" aria-labelledby="project-header-title" style="padding-top: 0;">
    <div class="container">
      <header class="project-header reveal-target">
        <div class="project-header__meta">
          <StatusDot 
            status={project.status === 'In progress' ? 'live' : 'planned'} 
            label={project.status} 
          />
          <Chip 
            variant="status" 
            status={project.status === 'In progress' ? 'in-progress' : 'planned'}
          >{project.status}</Chip>
          {hasStatusNote && (
            <p class="project-header__status-note">{project.statusNote}</p>
          )}
        </div>
        <h1 id="project-header-title" class="project-header__name">{project.name}</h1>
        {hasTagline && (
          <p class="project-header__tagline">{project.tagline}</p>
        )}
        <div class="project-header__tags">
          {project.tags.map(tag => <Chip variant="tag">{tag}</Chip>)}
        </div>
        <div class="project-header__actions">
          {project.repo ? (
            <a 
              class="btn btn--secondary" 
              href={project.repo} 
              target="_blank" 
              rel="noopener noreferrer"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
          ) : (
            <span class="btn btn--secondary btn--disabled" aria-disabled="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub · coming soon
            </span>
          )}
          {project.demo ? (
            <a 
              class="btn btn--secondary" 
              href={project.demo} 
              target="_blank" 
              rel="noopener noreferrer"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2"/>
                <path d="M8 21h8M12 17v4"/>
              </svg>
              Demo
            </a>
          ) : (
            <span class="btn btn--secondary btn--disabled" aria-disabled="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2"/>
                <path d="M8 21h8M12 17v4"/>
              </svg>
              Demo · coming soon
            </span>
          )}
        </div>
      </header>

      <!-- MEDIA / COVER -->
      <div class="project-media-section reveal-target">
        <ProjectMedia project={project} class="project-media--full" />
      </div>
    </div>
  </section>

  <!-- AT A GLANCE -->
  {hasFacts && (
    <section class="section facts-section" aria-labelledby="facts-title" style="padding-top: 0;">
      <div class="container">
        <div class="facts-grid reveal-target">
          {project.facts.map((fact, i) => (
            <div key={i} class="fact-card">
              <span class="fact-card__label">{fact.label}</span>
              <span class="fact-card__value">{fact.value}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- OVERVIEW -->
  {(hasSummary || hasPlainWords || hasGoal) && (
    <section class="section" aria-labelledby="overview-title">
      <div class="container">
        <SectionHeader number={getSectionNumber('overview')} label="Project" title="Overview" id="overview-title" />

        <div class="reveal-target">
          <HudCard>
            <div class="overview-content">
              {hasSummary && (
                <>
                  {project.summary.map((p, i) => (
                    <p key={i}>{p}</p>
                  ))}
                </>
              )}
              {hasPlainWords && (
                <div class="overview-plainwords">
                  <span class="overview-plainwords__label">IN PLAIN WORDS</span>
                  <p>{project.plainWords}</p>
                </div>
              )}
              {hasGoal && (
                <div class="overview-goal">
                  <span class="overview-goal__label">GOAL</span>
                  <span>{project.goal}</span>
                </div>
              )}
            </div>
          </HudCard>
        </div>
      </div>
    </section>
  )}

  <!-- THE PROBLEM -->
  {(hasProblem || hasBoundaries) && (
    <section class="section" aria-labelledby="problem-title">
      <div class="container">
        <SectionHeader number={getSectionNumber('problem')} label="Project" title="The Problem" id="problem-title" />

        <div class="reveal-target">
          <HudCard>
            <div class="problem-content">
              {hasProblem && (
                <div class="problem-main">
                  {project.problem?.intro && (
                    <p class="problem-intro">{project.problem.intro}</p>
                  )}
                  {project.problem?.points && project.problem.points.length > 0 && (
                    <ul class="problem-points">
                      {project.problem.points.map((point, i) => (
                        <li key={i} class="problem-point">
                          <span class="problem-point__dot" aria-hidden="true"></span>
                          <span>{point}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              )}
              {hasBoundaries && (
                <div class="problem-boundaries">
                  <h4 class="problem-boundaries__title">{project.boundaries?.title}</h4>
                  {project.boundaries?.items && project.boundaries.items.length > 0 && (
                    <ul class="problem-boundaries__items">
                      {project.boundaries.items.map((item, i) => (
                        <li key={i} class="problem-boundaries__item">
                          <span class="problem-boundaries__marker" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                              <circle cx="7" cy="7" r="6.5" stroke="currentColor" stroke-width="1.5"/>
                              <circle cx="7" cy="7" r="2.5" fill="currentColor"/>
                            </svg>
                          </span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              )}
            </div>
          </HudCard>
        </div>
      </div>
    </section>
  )}

  <!-- HOW IT WORKS -->
  {(hasSteps || hasArchitecture) && (
    <section class="section" aria-labelledby="how-title">
      <div class="container">
        <SectionHeader number={getSectionNumber('how-it-works')} label="Project" title="How It Works" id="how-title" />

        <div class="reveal-target">
          <HudCard>
            <div class="how-it-works-content">
              {hasSteps && (
                <div class="steps-section">
                  <ol class="steps-list">
                    {project.steps.map((step, i) => (
                      <li key={i} class="step-card">
                        <div class="step-card__connector" aria-hidden="true">
                          <span class="step-card__number">{i + 1}</span>
                          {i < project.steps.length - 1 && <span class="step-card__line"></span>}
                        </div>
                        <div class="step-card__content">
                          <div class="step-card__header">
                            <h4 class="step-card__title">{step.title}</h4>
                            {step.state && (
  step.state === 'planned' && <span class="state-badge state-badge--planned">PLANNED</span>
  || step.state === 'done' && <span class="state-badge state-badge--done">DONE</span>
  || (step.state === 'current' || step.state === 'next') && <span class="state-badge state-badge--current">{step.state === 'current' ? 'CURRENT' : 'NEXT'}</span>
)}
                          </div>
                          <p class="step-card__text">{step.text}</p>
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>
              )}

              {hasArchitecture && (
                <div class="architecture-section">
                  {project.architecture.map((layer, i) => (
                    <div key={i} class={`architecture-layer ${layer.state === 'planned' ? 'architecture-layer--planned' : ''}`}>
                      <div class="architecture-layer__header">
                        <div class="architecture-layer__meta">
                          <h4 class="architecture-layer__name">{layer.name}</h4>
                          {layer.note && <span class="architecture-layer__note">{layer.note}</span>}
                          {layer.state && (
  layer.state === 'planned' && <span class="state-badge state-badge--planned">PLANNED</span>
  || layer.state === 'done' && <span class="state-badge state-badge--done">DONE</span>
  || (layer.state === 'current' || layer.state === 'next') && <span class="state-badge state-badge--current">{layer.state === 'current' ? 'CURRENT' : 'NEXT'}</span>
)}
                        </div>
                      </div>
                      {layer.items && layer.items.length > 0 && (
                        <div class="architecture-layer__items">
                          {layer.items.map((item, j) => (
                            <Chip key={j} variant="tag">{item}</Chip>
                          ))}
                        </div>
                      )}
                      {i < project.architecture.length - 1 && (
                        <div class="architecture-layer__connector" aria-hidden="true">
                          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <line x1="8" y1="0" x2="8" y2="16" stroke="var(--border-strong)" stroke-width="1.5"/>
                            <polyline points="4 12 8 16 12 12" stroke="var(--border-strong)" stroke-width="1.5" fill="none"/>
                          </svg>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}

              {!hasSteps && !hasArchitecture && (
                <div class="how-it-works__diagram" aria-label={`${project.name} concept diagram`}>
                  <ProjectDiagram
                    variant={project.slug === 'rishi-os' ? 'hub' : 'flow'}
                    labels={
                      project.slug === 'rishi-os'
                        ? ['CEO agent', 'Research', 'Analysis', 'Content']
                        : project.slug === 'tech-intelligence-engine'
                          ? ['query', 'tech & AI\nindex', 'results']
                          : ['YouTube\nlink', 'notes', 'shelf']
                    }
                  />
                  <p class="how-it-works__placeholder">A step-by-step walkthrough is coming soon.</p>
                </div>
              )}
            </div>
          </HudCard>
        </div>
      </div>
    </section>
  )}

  <!-- MEET THE AGENTS -->
  {hasAgents && (
    <section class="section" aria-labelledby="agents-title">
      <div class="container">
        <SectionHeader number={getSectionNumber('agents')} label="Project" title="Meet the Agents" id="agents-title" />

        <div class="reveal-target">
          <HudCard>
            <div class="agents-grid">
              {ceoAgent && (
                <article class="agent-card agent-card--ceo">
                  <h4 class="agent-card__name">{ceoAgent.name}</h4>
                  <p class="agent-card__job">{ceoAgent.job}</p>
                  <Chip variant="tag" class="agent-card__output">{ceoAgent.output}</Chip>
                </article>
              )}
              {otherAgents.map((agent, i) => (
                <article key={i} class="agent-card">
                  <h4 class="agent-card__name">{agent.name}</h4>
                  <p class="agent-card__job">{agent.job}</p>
                  <Chip variant="tag" class="agent-card__output">{agent.output}</Chip>
                </article>
              ))}
            </div>
          </HudCard>
        </div>
      </div>
    </section>
  )}

  <!-- DESIGN PRINCIPLES -->
  {hasPrinciples && (
    <section class="section" aria-labelledby="principles-title">
      <div class="container">
        <SectionHeader number={getSectionNumber('principles')} label="Project" title="Design Principles" id="principles-title" />

        <div class="reveal-target">
          <HudCard>
            <div class="principles-grid">
              {project.principles.map((principle, i) => (
                <article key={i} class="principle-card">
                  <span class="principle-card__number">{i + 1}</span>
                  <h4 class="principle-card__title">{principle.title}</h4>
                  <p class="principle-card__text">{principle.text}</p>
                </article>
              ))}
            </div>
          </HudCard>
        </div>
      </div>
    </section>
  )}

  <!-- BUILT TO RUN ON FREE TIERS -->
  {hasLedger && (
    <section class="section" aria-labelledby="ledger-title">
      <div class="container">
        <SectionHeader number={getSectionNumber('ledger')} label="Project" title="Built to Run on Free Tiers" id="ledger-title" />

        <div class="reveal-target">
          <HudCard>
            <div class="ledger-content">
              <dl class="ledger-list">
                {project.ledger.map((item, i) => (
                  <div key={i} class="ledger-item">
                    <dt class="ledger-item__label">{item.label}</dt>
                    <dd class="ledger-item__value">{item.value}</dd>
                  </div>
                ))}
              </dl>
              {project.ledgerNote && (
                <p class="ledger-note">{project.ledgerNote}</p>
              )}
            </div>
          </HudCard>
        </div>
      </div>
    </section>
  )}

  <!-- TECH -->
  {hasTech && (
    <section class="section" aria-labelledby="tech-title">
      <div class="container">
        <SectionHeader number={getSectionNumber('tech')} label="Project" title="Tech" id="tech-title" />

        <div class="reveal-target">
          <HudCard>
            <div class="tech-chips">
              {project.tech.map((item, i) => (
                <Chip 
                  key={i} 
                  variant={item.state === 'planned' ? 'tag-planned' : 'tag'}
                  class={item.state === 'planned' ? 'tech-chip--planned' : ''}
                >
                  {item.name}
                  {item.state === 'planned' && <span class="tech-chip__state">planned</span>}
                </Chip>
              ))}
            </div>
            {allTechPlanned && (
              <p class="tech-all-planned">Planned stack. Nothing here is built yet.</p>
            )}
          </HudCard>
        </div>
      </div>
    </section>
  )}

  <!-- ROADMAP AND STATUS -->
  {(hasRoadmap || hasNextSteps) && (
    <section class="section" aria-labelledby="roadmap-title">
      <div class="container">
        <SectionHeader number={getSectionNumber('roadmap')} label="Project" title="Roadmap & Status" id="roadmap-title" />

        <div class="reveal-target">
          <HudCard>
            {hasRoadmap && (
              <div class="roadmap-timeline">
                {project.roadmap.map((phase, i) => (
                  <article key={i} class="roadmap-entry">
                    <div class="roadmap-entry__timeline" aria-hidden="true">
                      {phase.state === 'done' && <span class="timeline-dot timeline-dot--done"></span>
|| (phase.state === 'current' || phase.state === 'next') && <span class="timeline-dot timeline-dot--current"></span>
|| <span class="timeline-dot timeline-dot--planned"></span>}
                      {i < project.roadmap.length - 1 && <span class="roadmap-entry__line"></span>}
                    </div>
                    <div class="roadmap-entry__content">
                      <div class="roadmap-entry__header">
                        <span class="roadmap-entry__phase">{phase.phase}</span>
                        <h4 class="roadmap-entry__title">{phase.title}</h4>
                        {phase.state && (
  phase.state === 'planned' && <span class="state-badge state-badge--planned">PLANNED</span>
  || phase.state === 'done' && <span class="state-badge state-badge--done">DONE</span>
  || (phase.state === 'current' || phase.state === 'next') && <span class="state-badge state-badge--current">{phase.state === 'current' ? 'CURRENT' : 'NEXT'}</span>
)}
                      </div>
                      {phase.items && phase.items.length > 0 && (
                        <ul class="roadmap-entry__items">
                          {phase.items.map((item, j) => (
                            <li key={j}>{item}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            )}
            {!hasRoadmap && hasNextSteps && (
              <div class="next-steps-checklist">
                <ul class="next-steps-list">
                  {project.nextSteps.map((step, i) => (
                    <li key={i} class="next-step-item">
                      <span class="next-step-item__dot" aria-hidden="true">
                        <span class={step.done ? 'filled' : ''}></span>
                      </span>
                      <span class="next-step-item__text">{step.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </HudCard>
        </div>
      </div>
    </section>
  )}

  <!-- SCREENSHOTS -->
  {hasScreenshots && (
    <section class="section" aria-labelledby="screenshots-title">
      <div class="container">
        <SectionHeader number={getSectionNumber('screenshots')} label="Project" title="Screenshots" id="screenshots-title" />

        <div class="reveal-target">
          <HudCard>
            <div class="screenshots-grid" role="list">
              {project.screenshots.map((shot, i) => (
                <button
                  type="button"
                  key={i}
                  class="screenshot-thumb"
                  data-index={i}
                  data-src={shot.src}
                  data-caption={shot.caption}
                  aria-label={`View screenshot ${i + 1}: ${shot.caption}`}
                  role="listitem"
                >
                  <div class="screenshot-thumb__image-wrapper">
                    <img 
                      src={shot.src} 
                      alt={shot.caption} 
                      loading="lazy" 
                      decoding="async"
