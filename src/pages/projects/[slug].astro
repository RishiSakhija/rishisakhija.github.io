---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HudCard from '../../components/HudCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Chip from '../../components/Chip.astro';
import Button from '../../components/Button.astro';
import ProjectDiagram from '../../components/ProjectDiagram.astro';
import { projects, getPrevNext, getProject } from '../../data/projects.js';

export function getStaticPaths() {
  return projects.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getProject(slug as string);
const { prev, next } = getPrevNext(slug as string);

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}
---

<BaseLayout title={`${project.name} | Rishi Sakhija`} description={project.description}>

  <!-- Page Header Band -->
  <header class="page-header" aria-hidden="true">
    <div class="container">
      <nav class="page-header__breadcrumb" aria-label="Breadcrumb">
        <span>HOME</span>
        <span aria-hidden="true">/</span>
        <span>PROJECTS</span>
        <span aria-hidden="true">/</span>
        <span>{project.name.toUpperCase()}</span>
      </nav>
      <div class="page-header__number">01</div>
      <h1 class="page-header__title">{project.name}</h1>
    </div>
  </header>

  <section class="section" aria-labelledby="project-title">
    <div class="container">
      <header class="project-header reveal-target">
        <div class="project-header__meta">
          <Chip variant="status" status={project.status === 'In progress' ? 'in-progress' : 'planned'}>{project.status}</Chip>
          <div class="project-header__tags">
            {project.tags.map(tag => <Chip variant="tag">{tag}</Chip>)}
          </div>
        </div>
        <h1 id="project-title" class="project-header__name">{project.name}</h1>
        <p class="project-header__plain">{project.plainWords}</p>
      </header>
    </div>
  </section>

  <!-- Concept Diagram -->
  <section class="section" aria-labelledby="diagram-title" style="padding-top: 0;">
    <div class="container">
      <div class="reveal-target">
        <HudCard label="CONCEPT DIAGRAM">
          <ProjectDiagram
            variant={project.slug === 'agentic-team' ? 'hub' : 'flow'}
            labels={
              project.slug === 'agentic-team'
                ? ['CEO agent', 'Research', 'Analysis', 'Content']
                : project.slug === 'ai-search-engine'
                  ? ['query', 'tech & AI\nindex', 'results']
                  : ['YouTube\nlink', 'notes', 'shelf']
            }
          />
        </HudCard>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="overview-title">
    <div class="container">
      <SectionHeader number="02" label="Project" title="Overview" id="overview-title" />

      <div class="reveal-target">
        <HudCard>
          <p>{project.description}</p>
        </HudCard>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="plain-title">
    <div class="container">
      <SectionHeader number="03" label="Summary" title="In Plain Words" id="plain-title" />

      <div class="reveal-target">
        <HudCard>
          <p>{project.plainWords}</p>
        </HudCard>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="problem-title">
    <div class="container">
      <SectionHeader number="04" label="Context" title="Problem" id="problem-title" />

      <div class="reveal-target">
        <HudCard>
          <p>{project.problem}</p>
        </HudCard>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <SectionHeader number="05" label="Method" title="How It Works" id="how-title" />

      <div class="reveal-target">
        <HudCard>
          <p>{project.howItWorks}</p>
        </HudCard>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="tech-title">
    <div class="container">
      <SectionHeader number="06" label="Stack" title="Tech" id="tech-title" />

      <div class="reveal-target">
        <HudCard>
          <p>{project.tech}</p>
        </HudCard>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="status-title">
    <div class="container">
      <SectionHeader number="07" label="State" title="Status" id="status-title" />

      <div class="reveal-target">
        <HudCard>
          <p>{project.status}</p>
        </HudCard>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="links-title">
    <div class="container">
      <SectionHeader number="08" label="Access" title="Links" id="links-title" />

      <div class="reveal-target">
        <HudCard>
          <div class="project-links">
            <Button
              variant="primary"
              href={project.demoUrl}
              disabled={!project.demoUrl}
            >
              Demo
            </Button>
            <Button
              variant="secondary"
              href={project.codeUrl}
              disabled={!project.codeUrl}
            >
              Code
            </Button>
          </div>
          <p class="project-links__note">Links will be added when the project is ready for public access.</p>
        </HudCard>
      </div>
    </div>
  </section>

  {prev || next ? (
    <section class="section project-nav" aria-labelledby="nav-title">
      <div class="container">
        <nav class="project-nav__grid" aria-label="Project navigation">
          {prev && (
            <a class="project-nav__link project-nav__link--prev" href={`/projects/${prev.slug}`} aria-label={`Previous project: ${prev.name}`}>
              <span class="project-nav__label">Previous</span>
              <span class="project-nav__name">{prev.name}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"/>
              </svg>
            </a>
          )}
          {next && (
            <a class="project-nav__link project-nav__link--next" href={`/projects/${next.slug}`} aria-label={`Next project: ${next.name}`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
              <span class="project-nav__name">{next.name}</span>
              <span class="project-nav__label">Next</span>
            </a>
          )}
        </nav>
      </div>
    </section>
  ) : null}

</BaseLayout>

<style>
  /* Page Header Band */
  .page-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    margin-bottom: calc(var(--section-padding) - var(--space-6));
  }

  .page-header__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .page-header__breadcrumb span:not([aria-hidden]) {
    color: var(--text-fade);
  }

  .page-header__number {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--signal);
    margin-bottom: var(--space-1);
  }

  .page-header__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    background: linear-gradient(90deg, var(--text), var(--text-fade));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .project-header {
    margin-bottom: var(--space-8);
  }

  .project-header__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .project-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-header__name {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: var(--space-4);
  }

  .project-header__plain {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    max-width: 60ch;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .project-links__note {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
  }

  .project-nav {
    border-top: 1px solid var(--border);
    padding-top: var(--space-6);
  }

  .project-nav__grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .project-nav__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .project-nav__link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--surface);
    border: var(--card-border);
    border-radius: var(--radius-card);
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .project-nav__link:hover {
    border-color: var(--signal);
    background: var(--surface-2);
  }

  .project-nav__link:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }

  .project-nav__link--prev {
    flex-direction: row;
  }

  .project-nav__link--next {
    flex-direction: row-reverse;
    justify-content: flex-end;
  }

  .project-nav__label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .project-nav__name {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text-fade);
    transition: color 0.15s ease;
  }

  .project-nav__link:hover .project-nav__name {
    color: var(--text);
  }
</style>