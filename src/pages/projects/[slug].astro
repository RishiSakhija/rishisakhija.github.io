---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjectBySlug, getAllProjectSlugs } from '../../data/projects';
import Chip from '../../components/ui/Chip.astro';
import Button from '../../components/ui/Button.astro';

export async function getStaticPaths() {
  const slugs = getAllProjectSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug as string);

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}

const pageTitle = `${project.title} | Rishi Sakhija`;
const pageDescription = project.simpleWords;
const canonicalURL = `/projects/${project.slug}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
>
  <article class="project-detail" aria-labelledby="project-title">
    <div class="container">
      <header class="project-detail-header reveal">
        <span class="chip primary" style="margin-bottom: var(--space-md);">Case Study</span>
        <h1 id="project-title" class="project-detail-title">{project.title}</h1>
        <div class="project-detail-meta">
          <Chip variant="primary">{project.status === 'live' ? 'Live' : project.status === 'in-progress' ? 'In Progress' : project.status === 'planned' ? 'Planned' : 'Coming Soon'}</Chip>
          <span class="mono muted">{new Date().getFullYear()}</span>
        </div>
      </header>

      <div class="project-detail-simple reveal" style="--delay: 1">
        <strong>In simple words:</strong> {project.simpleWords}
      </div>

      <section class="project-detail-sections">
        <section class="project-detail-section reveal" style="--delay: 2">
          <h3>Overview</h3>
          <p>{project.overview}</p>
        </section>

        <section class="project-detail-section reveal" style="--delay: 3">
          <h3>Problem</h3>
          <p>{project.problem}</p>
        </section>

        <section class="project-detail-section reveal" style="--delay: 4">
          <h3>How It Works</h3>
          <div style="white-space: pre-line; color: var(--text-dim); line-height: 1.7;">
            {project.howItWorks}
          </div>
        </section>

        <section class="project-detail-section reveal" style="--delay: 5">
          <h3>Tech Stack</h3>
          <div class="project-detail-tags">
            {project.techStack.map((tech) => (
              <Chip>{tech}</Chip>
            ))}
          </div>
        </section>

        <section class="project-detail-section reveal" style="--delay: 6">
          <h3>What I Learned</h3>
          <p>{project.learned}</p>
        </section>

        <section class="project-detail-section reveal" style="--delay: 7">
          <h3>Status</h3>
          <span class="project-status {project.status}">
            {project.status === 'live' ? 'Live' : project.status === 'in-progress' ? 'In Progress' : project.status === 'planned' ? 'Planned' : 'Coming Soon'}
          </span>
          <p style="margin-top: var(--space-md); color: var(--muted); font-size: var(--fs-body-sm);">
            {project.status === 'in-progress' && 'Actively building. Core architecture in place, working on evaluation and polish.'}
            {project.status === 'planned' && 'Planning phase. Architecture designed, starting implementation soon.'}
            {project.status === 'live' && 'Deployed and in use. Monitoring and iterating based on real usage.'}
          </p>
        </section>
      </section>

      <footer class="project-detail-links reveal" style="--delay: 8">
        <Button
          href={project.demoUrl || '#'}
          variant="primary"
          disabled={project.status !== 'live'}
        >
          Live Demo
        </Button>
        <Button
          href={project.codeUrl || '#'}
          variant="secondary"
          disabled={project.status !== 'live'}
        >
          View Code
        </Button>
        <a href="/projects" class="btn btn-ghost">
          ← Back to Projects
        </a>
      </footer>
    </div>
  </article>
</BaseLayout>