---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HudCard from '../../components/HudCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Chip from '../../components/Chip.astro';
import ProjectDiagram from '../../components/ProjectDiagram.astro';
import { projects } from '../../data/projects.js';
---

<BaseLayout title="Projects | Rishi Sakhija" description="AI/ML builder focused on agents, automation, and search systems. Self-taught, remote, open to work.">

  <!-- Page Header Band -->
  <header class="page-header" aria-hidden="true">
    <div class="container">
      <nav class="page-header__breadcrumb" aria-label="Breadcrumb">
        <span>HOME</span>
        <span aria-hidden="true">/</span>
        <span>PROJECTS</span>
      </nav>
      <div class="page-header__number">01</div>
      <h1 class="page-header__title">Projects</h1>
    </div>
  </header>

  <section class="section" aria-labelledby="projects-title">
    <div class="container">
      <SectionHeader number="02" label="Portfolio" title="Projects" id="projects-title" />

      <div class="projects-grid">
        {projects.map(project => (
          <article class="reveal-target">
            <HudCard elevated>
              <div class="project-card">
                <div class="project-card__header">
                  <h3 class="project-card__name">{project.name}</h3>
                  <Chip variant="status" status={project.status === 'In progress' ? 'in-progress' : 'planned'}>{project.status}</Chip>
                </div>
                <p class="project-card__desc">{project.description}</p>
                <p class="project-card__plain">{project.plainWords}</p>
                <div class="project-card__diagram" aria-label={`${project.name} concept diagram`}>
                  <ProjectDiagram
                    variant={project.slug === 'agentic-team' ? 'hub' : 'flow'}
                    labels={
                      project.slug === 'agentic-team'
                        ? ['CEO agent', 'Research', 'Analysis', 'Content']
                        : project.slug === 'ai-search-engine'
                          ? ['query', 'tech & AI\nindex', 'results']
                          : ['YouTube\nlink', 'notes', 'shelf']
                    }
                  />
                </div>
                <div class="project-card__tags">
                  {project.tags.map(tag => (
                    <Chip variant="tag">{tag}</Chip>
                  ))}
                </div>
                <a class="project-card__link" href={`/projects/${project.slug}`} aria-label={`View ${project.name} project`}>
                  View project
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </a>
              </div>
            </HudCard>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Page Header Band */
  .page-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    margin-bottom: calc(var(--section-padding) - var(--space-6));
  }

  .page-header__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .page-header__breadcrumb span:not([aria-hidden]) {
    color: var(--text-fade);
  }

  .page-header__number {
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
    margin-bottom: var(--space-1);
  }

  .page-header__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    background: linear-gradient(90deg, var(--text), var(--text-fade));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .projects-grid {
    display: grid;
    gap: var(--card-gap);
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .project-card__name {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.125rem;
    line-height: 1.3;
    color: var(--text);
  }

  .project-card__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text);
    opacity: 0.85;
    margin-bottom: var(--space-3);
  }

  .project-card__plain {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-4);
    padding-left: var(--space-3);
    border-left: 1px solid var(--border);
  }

  .project-card__diagram {
    margin-bottom: var(--space-4);
    overflow: hidden;
  }

  .project-card__diagram svg {
    width: 100%;
    height: auto;
    max-height: 160px;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500.
    letter-spacing: 0.06em.
    color: var(--text).
    transition: color 0.15s ease, gap 0.15s ease.
    margin-top: auto.
  }

  .project-card__link:hover {
    color: var(--signal).
    gap: var(--space-3).
  }

  .project-card__link:focus-visible {
    outline: 2px solid var(--signal).
    outline-offset: 3px.
    border-radius: var(--radius-card).
  }
</style>