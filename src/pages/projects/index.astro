---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HudCard from '../../components/HudCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Chip from '../../components/Chip.astro';
import { projects } from '../../data/projects.js';
---

<BaseLayout title="Projects | Rishi Sakhija" description="AI/ML builder focused on agents, automation, and search systems. Self-taught, remote, open to work.">

  <section class="section" aria-labelledby="projects-title">
    <div class="container">
      <SectionHeader number="01" label="Portfolio" title="Projects" id="projects-title" />

      <div class="projects-grid">
        {projects.map(project => (
          <article class="reveal-target">
            <HudCard elevated>
              <div class="project-card">
                <div class="project-card__header">
                  <h3 class="project-card__name">{project.name}</h3>
                  <Chip variant="status">{project.status}</Chip>
                </div>
                <p class="project-card__desc">{project.description}</p>
                <p class="project-card__plain">{project.plainWords}</p>
                <div class="project-card__tags">
                  {project.tags.map(tag => (
                    <Chip variant="tag">{tag}</Chip>
                  ))}
                </div>
                <a class="project-card__link" href={`/projects/${project.slug}`} aria-label={`View ${project.name} project`}>
                  View project
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </a>
              </div>
            </HudCard>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .projects-grid {
    display: grid;
    gap: var(--card-gap);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .project-card__name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .project-card__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-fade);
    margin-bottom: var(--space-3);
  }

  .project-card__plain {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: var(--space-4);
    padding-left: var(--space-3);
    border-left: 1px solid var(--border);
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue-soft);
    transition: color 0.15s ease, gap 0.15s ease;
    margin-top: auto;
  }

  .project-card__link:hover {
    color: var(--red);
    gap: var(--space-3);
  }

  .project-card__link:focus-visible {
    outline: 2px solid var(--blue-soft);
    outline-offset: 3px;
    border-radius: var(--radius-card);
  }
</style>