---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HudCard from '../../components/HudCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Chip from '../../components/Chip.astro';
import StatusDot from '../../components/StatusDot.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import Button from '../../components/Button.astro';
import { projects } from '../../data/projects.js';
---

<BaseLayout title="Projects | Rishi Sakhija" description="Projects by Rishi Sakhija: Rishi-OS, a seven-agent system; the Tech Intelligence Engine, now in design; and Virtual Shelf, a lecture-to-notes app.">

  <!-- HEADER BAND -->
  <header class="page-header" aria-hidden="true">
    <div class="container">
      <nav class="page-header__breadcrumb" aria-label="Breadcrumb">
        <span>HOME</span>
        <span aria-hidden="true">/</span>
        <span>PROJECTS</span>
      </nav>
      <h1 class="page-header__title heading-gradient">Things I'm building.</h1>
      <p class="page-header__intro">
        These are the projects I'm working on: a seven-agent system that already runs, a tech intelligence engine whose design is complete, and a lecture-to-notes app in its early stage. Each one has its own page that explains how it works and where it stands.
      </p>
    </div>
  </header>

  <!-- 01 FEATURED WORK -->
  <section class="section" aria-labelledby="featured-title">
    <div class="container">
      <SectionHeader number="01" label="Portfolio" title="Featured Work" id="featured-title" />

      <div class="featured-rows">
        {projects.map((project, index) => {
          const isOdd = index % 2 === 0;
          const mediaFirst = isOdd;
          return (
            <article class="featured-row reveal-target" data-media-first={mediaFirst}>
              <div class="featured-row__media">
                <ProjectMedia project={project} />
              </div>
              <div class="featured-row__content">
                <div class="featured-row__header">
                  <StatusDot status={project.status === 'In progress' ? 'live' : 'planned'} label={project.status} />
                  <Chip variant="status" status={project.status === 'In progress' ? 'in-progress' : 'planned'}>{project.status}</Chip>
                </div>
                <h2 class="featured-row__name">{project.name}</h2>
                <p class="featured-row__plain">{project.plainWords}</p>
                <p class="featured-row__summary">{project.summary[0]}</p>
                <div class="featured-row__tags">
                  {project.tags.map(tag => (
                    <Chip variant="tag">{tag}</Chip>
                  ))}
                </div>
                <div class="featured-row__actions">
                  <a class="btn btn--secondary" href={`/projects/${project.slug}`}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6"/>
                      <polyline points="21 3 21 9 15 9"/>
                      <path d="M21 3l-9 9"/>
                    </svg>
                    Read case study
                  </a>
                  {project.repo ? (
                    <a class="btn btn--secondary" href={project.repo} target="_blank" rel="noopener noreferrer">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                      </svg>
                      GitHub
                    </a>
                  ) : (
                    <span class="btn btn--secondary btn--disabled" aria-disabled="true">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                      </svg>
                      GitHub · coming soon
                    </span>
                  )}
                  {project.demo ? (
                    <a class="btn btn--secondary" href={project.demo} target="_blank" rel="noopener noreferrer">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="3" width="20" height="14" rx="2"/>
                        <path d="M8 21h8M12 17v4"/>
                      </svg>
                      Demo
                    </a>
                  ) : (
                    <span class="btn btn--secondary btn--disabled" aria-disabled="true">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="3" width="20" height="14" rx="2"/>
                        <path d="M8 21h8M12 17v4"/>
                      </svg>
                      Demo · coming soon
                    </span>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 02 HOW I BUILD -->
  <section class="section" aria-labelledby="build-title">
    <div class="container">
      <SectionHeader number="02" label="Method" title="How I Build" id="build-title" />

      <div class="build-grid">
        <article class="build-card reveal-target">
          <HudCard>
            <span class="build-card__number">01</span>
            <h3 class="build-card__title">Start small</h3>
            <p class="build-card__desc">A working rough version first, then I improve it.</p>
          </HudCard>
        </article>
        <article class="build-card reveal-target">
          <HudCard>
            <span class="build-card__number">02</span>
            <h3 class="build-card__title">Use agents well</h3>
            <p class="build-card__desc">I direct AI coding assistants and review what they build.</p>
          </HudCard>
        </article>
        <article class="build-card reveal-target">
          <HudCard>
            <span class="build-card__number">03</span>
            <h3 class="build-card__title">Show the process</h3>
            <p class="build-card__desc">Each project page explains how it works and what I'm learning.</p>
          </HudCard>
        </article>
      </div>
    </div>
  </section>

  <!-- 03 CLOSING BLOCK -->
  <section class="section cta-section" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta-content reveal-target">
        <h2 id="cta-title" class="cta__title heading-gradient">Want to talk about a project?</h2>
        <p class="cta__subtitle">I'm happy to explain how any of these work.</p>
        <div class="cta__actions">
          <a class="btn btn--secondary" href="/contact">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            Get in touch
          </a>
          <a class="btn btn--secondary" href="https://github.com/RishiSakhija" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* HEADER BAND */
  .page-header {
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    padding-top: clamp(120px, 14vw, 160px);
  }

  .page-header__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .page-header__breadcrumb span:not([aria-hidden]) {
    color: var(--text-fade);
  }

  .page-header__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .page-header__intro {
    font-size: 18px;
    line-height: 1.75;
    font-weight: 500;
    color: var(--text-body);
    max-width: 64ch;
    margin-top: var(--space-4);
  }

  /* ============================================================
     01 FEATURED WORK
     ============================================================ */

  .featured-rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .featured-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--border);
  }

  .featured-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  @media (min-width: 768px) {
    .featured-row {
      grid-template-columns: 52% 48%;
      align-items: center;
    }

    .featured-row[data-media-first="true"] .featured-row__media {
      order: 1;
    }

    .featured-row[data-media-first="true"] .featured-row__content {
      order: 2;
    }

    .featured-row[data-media-first="false"] .featured-row__media {
      order: 2;
    }

    .featured-row[data-media-first="false"] .featured-row__content {
      order: 1;
    }
  }

  .featured-row__media {
    width: 100%;
  }

  .featured-row__header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .featured-row__name {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: var(--space-3);
  }

  .featured-row__plain {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-strong);
    margin-bottom: var(--space-3);
    padding-left: var(--space-3);
    border-left: 1px solid var(--border);
  }

  .featured-row__summary {
    font-size: 17px;
    line-height: 1.7;
    font-weight: 500;
    color: var(--text-body);
    margin-bottom: var(--space-4);
  }

  .featured-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .featured-row__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .featured-row__actions .btn--disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* ============================================================
     02 HOW I BUILD
     ============================================================ */

  .build-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--card-gap);
  }

  @media (min-width: 768px) {
    .build-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .build-card {
    height: 100%;
  }

  .build-card__number {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal-soft);
    margin-bottom: var(--space-3);
    display: block;
  }

  .build-card__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.3;
    color: var(--text);
    margin-bottom: var(--space-3);
  }

  .build-card__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-body);
  }

  /* ============================================================
     03 CLOSING BLOCK
     ============================================================ */

  .cta-section {
    border-top: 1px solid var(--border);
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  .cta-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .cta__title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    margin-bottom: var(--space-4);
  }

  .cta__subtitle {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-body);
    margin-bottom: var(--space-8);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  /* ============================================================
     REVEAL ANIMATION (gentle fade-up, never hides without JS)
     ============================================================ */

  .reveal-target {
    opacity: 1;
    transform: none;
  }

  .html.js .reveal-target {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .html.js .reveal-target.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .html.js .reveal-target {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>