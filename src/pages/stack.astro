---
import BaseLayout from '../layouts/BaseLayout.astro';
import { skillGroups } from '../data/skills';
import Chip from '../components/ui/Chip.astro';
---

<BaseLayout
  title="Stack"
  description="Tools and skills: Python, Git, GitHub, Machine Learning, Prompt Engineering, AI Agents, Workflow Automation."
>
  <section class="stack-page" aria-labelledby="stack-heading">
    <div class="container">
      <header class="stack-header reveal">
        <h1 id="stack-heading" class="stack-title">Stack</h1>
        <p class="stack-subtext">
          The tools, languages, and frameworks I use to build AI systems and automation.
        </p>
      </header>

      <div class="stack-categories">
        {skillGroups.map((group, index) => (
          <section class="stack-category reveal" style={`--delay: ${index + 1}`}>
            <h3 class="stack-category-label">{group.category}</h3>
            <div class="stack-chips">
              {group.skills.map((skill) => (
                <Chip variant="primary">{skill}</Chip>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>