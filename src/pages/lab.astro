---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chip from '../components/ui/Chip.astro';
import Button from '../components/ui/Button.astro';
import { labRoadmap, researchTopics, blogTopics } from '../data/lab';
---

<BaseLayout
  title="Lab"
  description="Research papers, experiments, and blog posts on AI agents, LLMs, RAG, and automation."
>
  <section class="lab-page" aria-labelledby="lab-heading">
    <div class="container">
      <header class="lab-header reveal">
        <h1 id="lab-heading" class="lab-title">Lab</h1>
        <p class="lab-subtext">
          Research papers, experiments, and blog posts on AI agents, LLMs, RAG, and automation.
        </p>
      </header>

      <div class="lab-tabs" role="tablist" aria-label="Lab sections">
        <button role="tab" aria-selected="true" id="tab-research" class="tab-btn active" data-tab="research">
          Research
        </button>
        <button role="tab" aria-selected="false" id="tab-blog" class="tab-btn" data-tab="blog">
          Blog
        </button>
      </div>

      <div role="tabpanel" id="panel-research" aria-labelledby="tab-research" class="tab-panel active">
        <section class="lab-section reveal" style="--delay: 1" aria-labelledby="research-heading">
          <h2 id="research-heading" class="lab-section-title">Research</h2>
          <p class="lab-section-subtext">
            Paper breakdowns, experiments, and learning notes on agents, LLMs, RAG, and automation.
          </p>

          <div class="topic-chips reveal" style="--delay: 2">
            {researchTopics.map((topic) => (
              <Chip variant="primary">{topic}</Chip>
            ))}
          </div>

          <div class="empty-state reveal" style="--delay: 3">
            <div class="empty-state-icon" aria-hidden="true">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                <path d="M2 12h20"/>
                <path d="M12 2a15.3 15.3 0 0 0 4 10 15.3 15.3 0 0 0-4 10 15.3 15.3 0 0 0-4-10 15.3 15.3 0 0 0-4-10 15.3 15.3 0 0 0 4-10z"/>
              </svg>
            </div>
            <h2 class="empty-state-title">Research Section — Coming Soon</h2>
            <p class="empty-state-text">
              This section will contain structured research notes: paper summaries with key takeaways, experiment logs with configs and results, and learning synthesis posts. Each entry will be tagged, searchable, and cross-referenced with projects.
            </p>
            <div style="margin-top: var(--space-xl); display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
              <Button variant="ghost" disabled>Filter by Tag</Button>
              <Button variant="ghost" disabled>Sort by Date</Button>
            </div>
          </div>
        </section>
      </div>

      <div role="tabpanel" id="panel-blog" aria-labelledby="tab-blog" class="tab-panel">
        <section class="lab-section reveal" style="--delay: 1" aria-labelledby="blog-heading">
          <h2 id="blog-heading" class="lab-section-title">Blog</h2>
          <p class="lab-section-subtext">
            Technical deep-dives, project retrospectives, and lessons learned building AI systems in public.
          </p>

          <div class="topic-chips reveal" style="--delay: 2">
            {blogTopics.map((topic) => (
              <Chip variant="primary">{topic}</Chip>
            ))}
          </div>

          <div class="empty-state reveal" style="--delay: 3">
            <div class="empty-state-icon" aria-hidden="true">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
              </svg>
            </div>
            <h2 class="empty-state-title">Blog — Coming Soon</h2>
            <p class="empty-state-text">
              Posts will include reading time, tags, and clean typography. Draft posts are hidden from the public feed. The first post will cover the architecture of the Agentic Team project — how a supervisor agent coordinates specialized workers through a typed message bus.
            </p>
            <div style="margin-top: var(--space-xl); display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
              <Button variant="ghost" disabled>Filter by Tag</Button>
              <Button variant="ghost" disabled>Sort by Date</Button>
            </div>
          </div>
        </section>
      </div>

      <section class="roadmap-section reveal" style="--delay: 4" aria-labelledby="roadmap-heading">
        <h2 id="roadmap-heading" class="lab-section-title">Planned Topics</h2>
        <p class="lab-section-subtext">
          Upcoming research and blog topics. Check back for updates!
        </p>
        <div class="roadmap-grid">
          {labRoadmap.map((topic, index) => (
            <article class="roadmap-item reveal" style={`--delay: ${index + 1}`}>
              <span class="roadmap-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </span>
              <span class="roadmap-text">{topic}</span>
            </article>
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>