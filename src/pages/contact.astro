---
import BaseLayout from '../layouts/BaseLayout.astro';
import HudCard from '../components/HudCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Chip from '../components/Chip.astro';
import StatusDot from '../components/StatusDot.astro';
import Button from '../components/Button.astro';
import { contactData } from '../data/contact.js';
---

<BaseLayout title="Contact | Rishi Sakhija" description="Get in touch with Rishi Sakhija, a self-taught AI/ML builder open to remote roles, freelance projects and collaborations.">

  <!-- HEADER BAND -->
  <header class="page-header" aria-hidden="true">
    <div class="container">
      <nav class="page-header__breadcrumb" aria-label="Breadcrumb">
        <span>HOME</span>
        <span aria-hidden="true">/</span>
        <span>CONTACT</span>
      </nav>
      <h1 class="page-header__title heading-gradient">Let's talk.</h1>
      <p class="page-header__intro">
        Whether you're hiring, have a project in mind, or just want to talk about AI, email is the quickest way to reach me. Pick an option below and a ready-made message opens in your email app. You only need to add your details and send it. I'll get back to you as soon as I can.
      </p>
    </div>
  </header>

  <!-- 01 HOW CAN I HELP -->
  <section class="section" aria-labelledby="help-title">
    <div class="container">
      <SectionHeader number="01" label="Reach Out" title="How Can I Help" id="help-title" />

      <div class="help-grid">
        {contactData.intents.map((intent) => (
          <article class="help-card reveal-target">
            <HudCard>
              <h3 class="help-card__title">{intent.title}</h3>
              <p class="help-card__desc">{intent.description}</p>
              <div class="help-card__meta">
                <span class="help-card__subject-label">SUBJECT:</span>
                <span class="help-card__subject">{intent.subject}</span>
              </div>
              <div class="help-card__actions">
                <a
                  class="btn btn--secondary"
                  href={`mailto:${contactData.email}?subject=${encodeURIComponent(intent.subject)}&body=${encodeURIComponent(intent.body)}`}
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2"/>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                  </svg>
                  Write this email
                </a>
                <a
                  class="help-card__gmail-link"
                  href={`https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(contactData.email)}&su=${encodeURIComponent(intent.subject)}&body=${encodeURIComponent(intent.body)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Open in Gmail
                </a>
              </div>
            </HudCard>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 DIRECT CHANNELS -->
  <section class="section" aria-labelledby="channels-title">
    <div class="container">
      <SectionHeader number="02" label="Connect" title="Direct Channels" id="channels-title" />

      <div class="channels-grid">
        {contactData.channels.map((channel) => (
          <article class="channel-card reveal-target">
            <HudCard>
              <div class="channel-card__header">
                <span class="channel-card__icon" aria-hidden="true">
                  {channel.icon === 'email' && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="4" width="20" height="16" rx="2"/>
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                    </svg>
                  )}
                  {channel.icon === 'linkedin' && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  )}
                  {channel.icon === 'github' && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                    </svg>
                  )}
                </span>
                <div class="channel-card__content">
                  <h3 class="channel-card__title">{channel.title}</h3>
                  <span class="channel-card__bestfor-label">BEST FOR</span>
                  <p class="channel-card__bestfor">{channel.bestFor}</p>
                </div>
                <div class="channel-card__actions">
                  {channel.action.type === 'copy' && (
                    <Button
                      variant="secondary"
                      id="copy-email-btn"
                      class="js-only"
                      type="button"
                    >
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="4" width="20" height="16" rx="2"/>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                      </svg>
                      Copy email
                    </Button>
                  )}
                  {channel.action.type === 'link' && (
                    <Button
                      variant="secondary"
                      href={channel.action.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {channel.action.label}
                    </Button>
                  )}
                </div>
              </div>
            </HudCard>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 AVAILABILITY -->
  <section class="section" aria-labelledby="availability-title">
    <div class="container">
      <SectionHeader number="03" label="Status" title="Availability" id="availability-title" />

      <div class="availability-grid">
        <div class="reveal-target">
          <HudCard>
            <div class="availability-status">
              <StatusDot status="live" label="Open to work · Remote" />
            </div>
          </HudCard>
        </div>

        <div class="reveal-target">
          <HudCard>
            <div class="availability-lists">
              <div class="availability-column">
                <span class="availability-label">OPEN TO</span>
                <ul class="availability-list">
                  {contactData.availability.openTo.map(item => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <div class="availability-column">
                <span class="availability-label">RIGHT NOW</span>
                <ul class="availability-list">
                  {contactData.availability.rightNow.map(item => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </div>
          </HudCard>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 WHAT TO INCLUDE -->
  <section class="section" aria-labelledby="include-title">
    <div class="container">
      <SectionHeader number="04" label="Details" title="What to Include" id="include-title" />

      <div class="include-grid">
        {contactData.whatToInclude.map((item) => (
          <article class="include-card reveal-target">
            <HudCard>
              <span class="include-card__number">{item.number}</span>
              <h3 class="include-card__title">{item.title}</h3>
              <p class="include-card__desc">{item.description}</p>
            </HudCard>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 QUESTIONS -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <SectionHeader number="05" label="FAQ" title="Questions" id="faq-title" />

      <div class="faq-list">
        {contactData.faq.map((item) => (
          <details class="faq-item reveal-target">
            <summary>
              <span>{item.question}</span>
              <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // Copy email button
  (() => {
    const btn = document.getElementById('copy-email-btn');
    if (!btn) return;

    async function copyEmail() {
      const email = 'rishisakhija7@gmail.com';
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(email);
        } else {
          const textarea = document.createElement('textarea');
          textarea.value = email;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
        }
        const originalText = btn.innerHTML;
        btn.innerHTML = `
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Copied
        `;
        setTimeout(() => {
          btn.innerHTML = originalText;
        }, 2000);
      } catch (e) {
        // fallback mailto link handles it
      }
    }

    btn.addEventListener('click', copyEmail);
  })();
</script>

<style>
  /* HEADER BAND */
  .page-header {
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    padding-top: clamp(120px, 14vw, 160px);
  }

  .page-header__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .page-header__breadcrumb span:not([aria-hidden]) {
    color: var(--text-fade);
  }

  .page-header__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .page-header__intro {
    font-size: 18px;
    line-height: 1.75;
    font-weight: 500;
    color: var(--text-body);
    max-width: 62ch;
    margin-top: var(--space-4);
  }

  /* ============================================================
     01 HOW CAN I HELP
     ============================================================ */

  .help-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--card-gap);
  }

  @media (min-width: 768px) {
    .help-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .help-card {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .help-card__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.3;
    color: var(--text);
    margin-bottom: var(--space-3);
  }

  .help-card__desc {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: var(--space-4);
  }

  .help-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .help-card__subject-label {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-strong);
  }

  .help-card__subject {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-fade);
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .help-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin-top: auto;
  }

  .help-card__gmail-link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal-soft);
    transition: color 0.15s ease;
  }

  .help-card__gmail-link:hover {
    color: var(--signal);
  }

  .help-card__gmail-link:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
    border-radius: var(--radius-card);
  }

  /* ============================================================
     02 DIRECT CHANNELS
     ============================================================ */

  .channels-grid {
    display: flex;
    flex-direction: column;
    gap: var(--card-gap);
  }

  .channel-card {
    height: 100%;
  }

  .channel-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .channel-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-card);
    background: var(--surface-2);
    flex-shrink: 0;
    color: var(--signal);
  }

  .channel-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .channel-card__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.3;
    color: var(--text);
  }

  .channel-card__bestfor-label {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-strong);
  }

  .channel-card__bestfor {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .channel-card__actions {
    margin-top: var(--space-4);
  }

  /* ============================================================
     03 AVAILABILITY
     ============================================================ */

  .availability-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--card-gap);
  }

  @media (min-width: 768px) {
    .availability-grid {
      grid-template-columns: 1fr 2fr;
    }
  }

  .availability-status {
    margin-bottom: var(--space-6);
  }

  .availability-lists {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .availability-lists {
      grid-template-columns: 1fr 1fr;
    }
  }

  .availability-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .availability-label {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal-soft);
  }

  .availability-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .availability-list li {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-body);
    position: relative;
    padding-left: var(--space-4);
  }

  .availability-list li::before {
    content: '>';
    position: absolute;
    left: 0;
    color: var(--signal-soft);
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ============================================================
     04 WHAT TO INCLUDE
     ============================================================ */

  .include-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--card-gap);
  }

  @media (min-width: 768px) {
    .include-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .include-card {
    height: 100%;
  }

  .include-card__number {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal-soft);
    margin-bottom: var(--space-3);
    display: block;
  }

  .include-card__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.3;
    color: var(--text);
    margin-bottom: var(--space-3);
  }

  .include-card__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-body);
  }

  /* ============================================================
     05 QUESTIONS
     ============================================================ */

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .faq-item:hover {
    border-color: var(--signal);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text);
    cursor: pointer;
    list-style: none;
    transition: background 0.15s ease;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:hover {
    background: var(--surface-2);
  }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: -2px;
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--signal);
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--space-5) var(--space-5);
    animation: faq-fade-in 200ms ease;
  }

  @keyframes faq-fade-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .faq-answer p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-body);
    margin: 0;
  }

  /* ============================================================
     CTA EMAIL ROW (shared with About page)
     ============================================================ */

  .cta-section {
    border-top: 1px solid var(--border);
    padding-top: var(--space-8);
  }

  .cta-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .cta__title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    margin-bottom: var(--space-4);
  }

  .cta__subtitle {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-body);
    margin-bottom: var(--space-8);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .cta__email {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text-fade);
  }

  /* ============================================================
     REVEAL ANIMATION (gentle fade-up, never hides without JS)
     ============================================================ */

  .reveal-target {
    opacity: 1;
    transform: none;
  }

  .html.js .reveal-target {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .html.js .reveal-target.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .html.js .reveal-target {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>