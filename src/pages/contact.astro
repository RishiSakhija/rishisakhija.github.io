---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chip from '../components/ui/Chip.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Rishi Sakhija — open to opportunities, collaborations, and conversations about AI."
>
  <section class="contact-page" aria-labelledby="contact-heading">
    <div class="container">
      <header class="contact-page-header reveal">
        <h1 id="contact-heading" class="contact-page-title">Get in Touch</h1>
        <p class="contact-page-subtext">
          Open to opportunities, collaborations, and conversations about AI.
        </p>
      </header>

      <div class="contact-buttons" role="list">
        <a
          href="mailto:rishisakhija7@gmail.com"
          class="contact-btn"
          role="listitem"
        >
          <span class="contact-btn-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </span>
          <span>Email</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>

        <a
          href="https://github.com/RishiSakhija"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-btn"
          role="listitem"
        >
          <span class="contact-btn-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
            </svg>
          </span>
          <span>GitHub</span>
        </a>

        <a
          href="https://www.linkedin.com/in/rishisakhija"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-btn"
          role="listitem"
        >
          <span class="contact-btn-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </span>
          <span>LinkedIn</span>
        </a>

        {/* Resume download slot - uncomment when ready */}
        {/* <a href="/resume.pdf" class="contact-btn" download>
          <span class="contact-btn-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
          </span>
          <span>Download Resume</span>
        </a> */}
      </div>

      <p class="contact-closing">
        Open to opportunities, collaborations, and conversations about AI.
      </p>
    </div>
  </section>
</BaseLayout>