---
import BaseLayout from '../layouts/BaseLayout.astro';
import RSLogo from '../components/RSLogo.astro';
import StatusDot from '../components/StatusDot.astro';
import Button from '../components/Button.astro';
import Ticker from '../components/Ticker.astro';
import HudCard from '../components/HudCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Chip from '../components/Chip.astro';
import ProjectDiagram from '../components/ProjectDiagram.astro';
import { projects } from '../data/projects.js';
---

<BaseLayout title="Rishi Sakhija | AI/ML Builder" description="AI/ML builder focused on agents, automation, and search systems. Self-taught, remote, open to work.">

  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero__content">
        <!-- Tick mark ruler on left -->
        <div class="hero__ruler" aria-hidden="true">
          <span class="hero__ruler-mark" style="--i:0"></span>
          <span class="hero__ruler-mark" style="--i:1"></span>
          <span class="hero__ruler-mark" style="--i:2"></span>
          <span class="hero__ruler-mark" style="--i:3"></span>
          <span class="hero__ruler-mark" style="--i:4"></span>
          <span class="hero__ruler-mark" style="--i:5"></span>
        </div>

        <!-- Oversized RS watermark -->
        <div class="hero__watermark" aria-hidden="true">
          <RSLogo size={280} />
        </div>

        <div class="hero__status" role="status" aria-live="polite">
          <StatusDot status="live" label="open to work · remote" />
        </div>

        <h1 id="hero-title" class="hero__name">
          <span style="color: var(--text); -webkit-text-fill-color: var(--text); background: none;">Rishi</span>Sakhija
          <span class="sr-only">Rishi Sakhija</span>
        </h1>

        <p class="hero__role" aria-hidden="true">AI/ML builder in the making · Agents & Automation</p>

        <p class="hero__bio">
          Self-taught for 2.5+ years, I design and build AI agents, search systems, and automation that turn complex work into simple workflows.
        </p>

        <div class="hero__actions">
          <Button variant="primary" href="/projects">View Projects</Button>
          <Button variant="secondary" href="/contact">Get in Touch</Button>
        </div>

        <div class="hero__scroll-cue" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
          <span>scroll</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TICKER -->
  <section class="ticker-section" aria-hidden="true">
    <Ticker />
  </section>

  <!-- 01 FEATURED PROJECTS -->
  <section class="section" aria-labelledby="featured-title">
    <div class="container">
      <SectionHeader number="01" label="Featured" title="Projects" id="featured-title" />

      <div class="projects-grid">
        {projects.map(project => (
          <article class="reveal-target">
            <HudCard elevated>
              <div class="project-card">
                <div class="project-card__header">
                  <h3 class="project-card__name">{project.name}</h3>
                  <Chip variant="status" status={project.status === 'In progress' ? 'in-progress' : 'planned'}>{project.status}</Chip>
                </div>
                <p class="project-card__desc">{project.plainWords}</p>
                <div class="project-card__diagram" aria-label={`${project.name} concept diagram`}>
                  <ProjectDiagram
                    variant={project.slug === 'agentic-team' ? 'hub' : 'flow'}
                    labels={
                      project.slug === 'agentic-team'
                        ? ['CEO agent', 'Research', 'Analysis', 'Content']
                        : project.slug === 'ai-search-engine'
                          ? ['query', 'tech & AI\nindex', 'results']
                          : ['YouTube\nlink', 'notes', 'shelf']
                    }
                  />
                </div>
                <div class="project-card__tags">
                  {project.tags.map(tag => (
                    <Chip variant="tag">{tag}</Chip>
                  ))}
                </div>
                <a class="project-card__link" href={`/projects/${project.slug}`} aria-label={`View ${project.name} project`}>
                  View project
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </a>
              </div>
            </HudCard>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 NOW -->
  <section class="section" aria-labelledby="now-title">
    <div class="container">
      <SectionHeader number="02" label="System" title="Now" id="now-title" />

      <div class="now-grid">
        <article class="reveal-target">
          <HudCard label="BUILDING">
            <ul class="now-list">
              <li>A compact search engine for tech and AI</li>
              <li>AI agents that work in coordination</li>
            </ul>
          </HudCard>
        </article>
        <article class="reveal-target">
          <HudCard label="LEARNING">
            <ul class="now-list">
              <li>Real-world tech, AI, ML, and the agentic era</li>
            </ul>
          </HudCard>
        </article>
        <article class="reveal-target">
          <HudCard label="AIMING FOR">
            <ul class="now-list">
              <li>A professional personal brand and digital identity</li>
            </ul>
          </HudCard>
        </article>
      </div>
    </div>
  </section>

  <!-- 03 HOW I WORK -->
  <section class="section" aria-labelledby="work-title">
    <div class="container">
      <SectionHeader number="03" label="Method" title="How I Work" id="work-title" />

      <div class="work-grid">
        <article class="reveal-target">
          <HudCard label="BUILD">
            <p>I learn by building real projects. Every component here — the search index, the note generator, the guide — started as a prototype I needed.</p>
          </HudCard>
        </article>
        <article class="reveal-target">
          <HudCard label="AUTOMATE">
            <p>I turn repetitive work into agent-driven workflows. The search index, the note generator — each removes a manual step from my process.</p>
          </HudCard>
        </article>
        <article class="reveal-target">
          <HudCard label="LEARN IN PUBLIC">
            <p>Everything here is work in progress, shared as I go. The code, the designs, the failures — all visible. Feedback loops make it better.</p>
          </HudCard>
        </article>
      </div>
    </div>
  </section>

  <!-- 04 ABOUT TEASER -->
  <section class="section" aria-labelledby="about-teaser-title">
    <div class="container">
      <SectionHeader number="04" label="Profile" title="About" id="about-teaser-title" />

      <div class="about-teaser reveal-target">
        <HudCard>
          <p>I'm Rishi Sakhija, a Computer Engineering diploma student and self-taught builder with over 2.5 years of hands-on work in AI and machine learning.</p>
          <p>My focus is the agentic era: systems that reason, coordinate, and act. I learn by building, and everything here is real work in progress.</p>
          <a href="/about" class="about-teaser__link">
            Read more
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        </HudCard>
      </div>
    </div>
  </section>

  <!-- 05 ROADMAP -->
  <section class="section" aria-labelledby="roadmap-title">
    <div class="container">
      <SectionHeader number="05" label="Future" title="Roadmap" id="roadmap-title" />

      <div class="roadmap reveal-target">
        <HudCard>
          <div class="roadmap__chips">
            <Chip variant="tag">Lab (research & blog) <span class="chip__status">planned</span></Chip>
            <Chip variant="tag">Real project links <span class="chip__status">planned</span></Chip>
            <Chip variant="tag">Resume download <span class="chip__status">planned</span></Chip>
            <Chip variant="tag">RS Guide powered by real AI <span class="chip__status">planned</span></Chip>
          </div>
          <p class="roadmap__note">All items are concepts. Nothing shipped until it's real.</p>
        </HudCard>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="section cta-section" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta-content reveal-target">
        <h2 id="cta-title" class="cta__title">Open to opportunities, collaborations, and conversations about AI.</h2>
        <div class="cta__actions">
          <Button variant="primary" href="mailto:rishisakhija7@gmail.com">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            Email
          </Button>
          <Button variant="secondary" href="https://github.com/RishiSakhija" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </Button>
          <Button variant="secondary" href="https://www.linkedin.com/in/rishisakhija" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </Button>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // Scroll cue fade on scroll
  (() => {
    const cue = document.querySelector('.hero__scroll-cue');
    if (!cue) return;
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          cue.style.opacity = Math.max(0, 1 - scrollY / 200);
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  })();
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: calc(85svh - 64px);
    padding-block: var(--space-9);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__content {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  .hero__ruler {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    pointer-events: none;
    z-index: 0;
  }

  @media (max-width: 1023px) {
    .hero__ruler {
      display: none;
    }
  }

  .hero__ruler-mark {
    width: 2px;
    height: 12px;
    background: var(--border);
    opacity: 0.6;
  }

  .hero__ruler-mark:nth-child(odd) {
    height: 20px;
    background: var(--signal);
    opacity: 0.3;
  }

  .hero__watermark {
    position: absolute;
    right: -60px;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.02;
    pointer-events: none;
    z-index: 0;
  }

  @media (max-width: 1023px) {
    .hero__watermark {
      display: none;
    }
  }

  .hero__status {
    margin-bottom: var(--space-5);
  }

  .hero__name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(3.4rem, 12vw, 12rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
    white-space: nowrap;
    overflow: hidden;
  }

  .hero__name .text-gradient {
    background: linear-gradient(90deg, var(--text), var(--text-fade));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (max-width: 360px) {
    .hero__name {
      font-size: clamp(2.8rem, 14vw, 10rem);
    }
  }

  .hero__role {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-6);
  }

  .hero__bio {
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-fade);
    max-width: 55ch;
    margin-bottom: var(--space-8);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .hero__scroll-cue {
    position: absolute;
    bottom: var(--space-6);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0.6;
    animation: scroll-bounce 2s ease-in-out infinite;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  @keyframes scroll-bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-cue {
      animation: none;
    }
  }

  .ticker-section {
    padding-top: 0;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    gap: var(--card-gap);
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .project-card__name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.3;
    color: var(--text);
  }

  .project-card__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text);
    opacity: 0.85;
    margin-bottom: var(--space-4);
    flex: 1;
  }

  .project-card__diagram {
    margin-bottom: var(--space-4);
    overflow: hidden;
  }

  .project-card__diagram svg {
    width: 100%;
    height: auto;
    max-height: 160px;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text);
    transition: color 0.15s ease, gap 0.15s ease;
    margin-top: auto;
  }

  .project-card__link:hover {
    color: var(--signal);
    gap: var(--space-3);
  }

  .project-card__link:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
    border-radius: var(--radius-card);
  }

  .now-grid {
    display: grid;
    gap: var(--card-gap);
  }

  @media (min-width: 768px) {
    .now-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .now-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .now-list li {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-fade);
    padding-left: var(--space-4);
    position: relative;
  }

  .now-list li::before {
    content: '>';
    position: absolute;
    left: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  /* How I Work */
  .work-grid {
    display: grid;
    gap: var(--card-gap);
  }

  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* About Teaser */
  .about-teaser {
    max-width: 800px;
  }

  .about-teaser__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.15s ease, gap 0.15s ease;
  }

  .about-teaser__link:hover {
    color: var(--signal);
    gap: var(--space-3);
  }

  .about-teaser__link:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
    border-radius: var(--radius-card);
  }

  /* Roadmap */
  .roadmap__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .chip__status {
    margin-left: var(--space-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
  }

  .roadmap__note {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  /* CTA Section */
  .cta-section {
    border-top: 1px solid var(--border);
    padding-top: var(--space-8);
  }

  .cta__title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    text-align: center;
    margin-bottom: var(--space-6);
    background: linear-gradient(90deg, var(--text), var(--text-fade));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }
</style>