---
import BaseLayout from '../layouts/BaseLayout.astro';
import RSLogo from '../components/RSLogo.astro';
import StatusDot from '../components/StatusDot.astro';
import Button from '../components/Button.astro';
import Ticker from '../components/Ticker.astro';
import HudCard from '../components/HudCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Chip from '../components/Chip.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import { projects } from '../data/projects.js';
import { sinceText } from '../data/profile.js';
import { journeyData } from '../data/journey.js';
---

<BaseLayout title="Rishi Sakhija | AI/ML Builder" description="AI/ML builder focused on agents and automation. Self-taught, remote, open to work.">

  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero__content">
        <!-- Tick mark ruler on left -->
        <div class="hero__ruler" aria-hidden="true">
          <span class="hero__ruler-mark" style="--i:0"></span>
          <span class="hero__ruler-mark" style="--i:1"></span>
          <span class="hero__ruler-mark" style="--i:2"></span>
          <span class="hero__ruler-mark" style="--i:3"></span>
          <span class="hero__ruler-mark" style="--i:4"></span>
          <span class="hero__ruler-mark" style="--i:5"></span>
        </div>

        <!-- Oversized RS watermark -->
        <div class="hero__watermark" aria-hidden="true">
          <RSLogo size={280} />
        </div>

        <div class="hero__status" role="status" aria-live="polite">
          <StatusDot status="live" label="Open to work · Remote" />
        </div>

        <h1 id="hero-title" class="hero__name">
          <span style="color: var(--text); -webkit-text-fill-color: var(--text); background: none;">Rishi</span><span class="name-gradient">Sakhija</span>
          <span class="sr-only">Rishi Sakhija</span>
        </h1>

        <p class="hero__role" aria-hidden="true">AI/ML builder in the making · Agents & Automation</p>

        <p class="hero__bio">
          Self-taught since 2024, I design and build AI agents and automation that turn complex work into simple workflows, and I'm now building a compact search engine for tech and AI.
        </p>

        <div class="hero__actions">
          <Button variant="primary" href="/projects">View Projects</Button>
          <Button variant="secondary" href="/contact">Get in Touch</Button>
        </div>

        <div class="hero__scroll-cue" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
          <span>scroll</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TICKER -->
  <section class="ticker-section" aria-hidden="true">
    <Ticker />
  </section>

  <!-- 01 WHO I AM -->
  <section class="section" aria-labelledby="who-title">
    <div class="container">
      <SectionHeader number="01" label="About Me" title="Who I am" id="who-title" />

      <div class="who-grid">
        <div class="who-text reveal-target">
          <p>I'm Rishi Sakhija, a Computer Engineering diploma student and a self-taught builder. Since 2024 I've been learning AI and machine learning the hands-on way: picking a problem, building something, breaking it, and learning from what went wrong.</p>
          <p>My focus is the agentic era, where AI does more than answer questions: it plans, coordinates, and takes action. I design AI agents that work together and automations that remove repetitive work, and I'm now building a compact search engine for tech and AI. This site is my working notebook in public, and everything on it is real work in progress.</p>
        </div>
        <aside class="who-facts reveal-target">
          <HudCard>
            <div class="who-facts__rows">
              <div class="who-facts__row">
                <span class="who-facts__label">Based</span>
                <span class="who-facts__value">Remote</span>
              </div>
              <div class="who-facts__row">
                <span class="who-facts__label">Status</span>
                <span class="who-facts__value">Open to work</span>
              </div>
              <div class="who-facts__row">
                <span class="who-facts__label">Studying</span>
                <span class="who-facts__value">Computer Engineering diploma</span>
              </div>
              <div class="who-facts__row">
                <span class="who-facts__label">Experience</span>
                <span class="who-facts__value">Self-taught since 2024</span>
              </div>
            </div>
          </HudCard>
        </aside>
      </div>
    </div>
  </section>

  <!-- TICKER -->
  <section class="ticker-section" aria-hidden="true">
    <Ticker />
  </section>

  <!-- 02 WHAT I DO -->
  <section class="section" aria-labelledby="whatido-title">
    <div class="container">
      <SectionHeader number="02" label="Focus" title="What I Do" id="whatido-title" />

      <div class="whatido-rows">
        <article class="whatido-row reveal-target">
          <span class="whatido-row__number" aria-hidden="true">01</span>
          <div class="whatido-row__content">
            <h3 class="whatido-row__title">Build AI agents</h3>
            <p class="whatido-row__desc">I design specialized AI agents, each with a clear job, and connect them so they can work alone or as a team under a supervising agent. The goal is simple: hand routine tasks to a coordinated set of helpers instead of doing everything by hand.</p>
          </div>
          <div class="whatido-row__tags">
            <Chip variant="tag">AI Agents</Chip>
            <Chip variant="tag">Python</Chip>
          </div>
        </article>

        <article class="whatido-row reveal-target">
          <span class="whatido-row__number" aria-hidden="true">02</span>
          <div class="whatido-row__content">
            <h3 class="whatido-row__title">Automate workflows</h3>
            <p class="whatido-row__desc">I look for work that repeats, such as collecting information, organizing notes or preparing drafts, and turn it into a reliable automated workflow. I keep each automation simple enough to understand, fix and improve over time.</p>
          </div>
          <div class="whatido-row__tags">
            <Chip variant="tag">Automation</Chip>
            <Chip variant="tag">Python</Chip>
          </div>
        </article>

        <article class="whatido-row reveal-target">
          <span class="whatido-row__number" aria-hidden="true">03</span>
          <div class="whatido-row__content">
            <h3 class="whatido-row__title">Prompting and search</h3>
            <p class="whatido-row__desc">I practice prompt engineering: writing clear instructions that make AI tools give dependable, usable results. Alongside it, I'm building a compact search engine that covers only tech and AI, so useful answers are easier to find.</p>
          </div>
          <div class="whatido-row__tags">
            <Chip variant="tag">Prompt engineering</Chip>
            <Chip variant="tag">Search (in progress)</Chip>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 03 SELECTED WORK -->
  <section class="section" aria-labelledby="work-title">
    <div class="container">
      <SectionHeader number="03" label="Portfolio" title="Selected Work" id="work-title" />

      <div class="work-rows">
        {projects.map(project => (
          <article class="work-row reveal-target">
            <a class="work-row__link" href={`/projects/${project.slug}`} aria-label={`View ${project.name} project`}>
              <div class="work-row__content">
                <div class="work-row__header">
                  <h3 class="work-row__name">{project.name}</h3>
                  <Chip variant="status" status={project.status === 'In progress' ? 'in-progress' : 'planned'}>{project.status}</Chip>
                </div>
                <p class="work-row__desc">{project.plainWords}</p>
                <div class="work-row__tags">
                  {project.tags.map(tag => (
                    <Chip variant="tag">{tag}</Chip>
                  ))}
                </div>
                <details class="work-row__more">
                  <summary>
                    <span>Read more</span>
                    <svg class="work-row__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="6 9 12 15 18 9"/>
                    </svg>
                  </summary>
                  <div class="work-row__more-content">
                    {project.summary.map(p => <p>{p}</p>)}
                    <div class="work-row__goal">
                      <span class="label">GOAL</span>
                      <span>{project.goal}</span>
                    </div>
                  </div>
                </details>
              </div>
              <div class="work-row__diagram" aria-label={`${project.name} concept diagram`}>
                <ProjectMedia project={project} />
              </div>
              <span class="work-row__arrow" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 JOURNEY -->
  <section class="section" aria-labelledby="journey-title">
    <div class="container">
      <SectionHeader number="04" label="History" title="Journey" id="journey-title" />

      <div class="journey">
        {journeyData.map((entry, i) => (
          <article class="journey-item reveal-target">
            <div class="journey-item__dot" aria-hidden="true" data-planned={entry.planned}></div>
            <div class="journey-item__content">
              <span class="journey-item__label">{entry.label}</span>
              <h3 class="journey-item__title">{entry.title}</h3>
              <p class="journey-item__desc">{entry.text}</p>
              <div class="journey-item__chips">
                {entry.chips.map(chip => <Chip variant="tag">{chip}</Chip>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 NOW -->
  <section class="section" aria-labelledby="now-title">
    <div class="container">
      <SectionHeader number="05" label="System" title="Now" id="now-title" />

      <div class="now-grid">
        <article class="reveal-target">
          <HudCard label="BUILDING">
            <ul class="now-list">
              <li>A compact search engine for tech and AI</li>
              <li>AI agents that work in coordination</li>
            </ul>
          </HudCard>
        </article>
        <article class="reveal-target">
          <HudCard label="LEARNING">
            <ul class="now-list">
              <li>Real-world tech, AI, ML, and the agentic era</li>
            </ul>
          </HudCard>
        </article>
        <article class="reveal-target">
          <HudCard label="AIMING FOR">
            <ul class="now-list">
              <li>A professional personal brand and digital identity</li>
            </ul>
          </HudCard>
        </article>
      </div>
    </div>
  </section>

  <!-- 06 HOW I WORK -->
  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <SectionHeader number="06" label="Method" title="How I Work" id="how-title" />

      <div class="work-grid">
        <article class="reveal-target">
          <HudCard label="BUILD">
            <p>I learn by building real projects. Every component here — the search index, the note generator, the guide — started as a prototype I needed.</p>
          </HudCard>
        </article>
        <article class="reveal-target">
          <HudCard label="AUTOMATE">
            <p>I turn repetitive work into agent-driven workflows. The search index, the note generator — each removes a manual step from my process.</p>
          </HudCard>
        </article>
        <article class="reveal-target">
          <HudCard label="LEARN IN PUBLIC">
            <p>Everything here is work in progress, shared as I go. The code, the designs, the failures — all visible. Feedback loops make it better.</p>
          </HudCard>
        </article>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="section cta-section" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta-content reveal-target">
        <h2 id="cta-title" class="cta__title heading-gradient">Let's build something together.</h2>
        <p class="cta__subtitle">Open to opportunities, collaborations, and conversations about AI.</p>
        <div class="cta__actions">
          <Button
            variant="secondary"
            id="copy-email-btn"
            class="js-only"
            type="button"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            Copy email
          </Button>
          <Button variant="secondary" href="https://github.com/RishiSakhija" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </Button>
          <Button variant="secondary" href="https://www.linkedin.com/in/rishisakhija" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </Button>
        </div>
        <p class="cta__email">rishisakhija7@gmail.com</p>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // Scroll cue fade on scroll
  (() => {
    const cue = document.querySelector('.hero__scroll-cue');
    if (!cue) return;
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          cue.style.opacity = Math.max(0, 1 - scrollY / 200);
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  })();

  // Spotlight effect on cards
  (() => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;
    if ('ontouchstart' in window || navigator.maxTouchPoints > 0) return;

    const cards = document.querySelectorAll('.hud-card--elevated');
    if (!cards.length) return;

    cards.forEach(card => {
      let mx = 0, my = 0;
      card.addEventListener('pointermove', (e) => {
        const rect = card.getBoundingClientRect();
        mx = ((e.clientX - rect.left) / rect.width) * 100;
        my = ((e.clientY - rect.top) / rect.height) * 100;
        card.style.setProperty('--mx', `${mx}%`);
        card.style.setProperty('--my', `${my}%`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--mx');
        card.style.removeProperty('--my');
      });
    });
  })();

  // Copy email button
  (() => {
    const btn = document.getElementById('copy-email-btn');
    if (!btn) return;

    async function copyEmail() {
      const email = 'rishisakhija7@gmail.com';
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(email);
        } else {
          // Fallback for non-secure contexts
          const textarea = document.createElement('textarea');
          textarea.value = email;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
        }
        const originalText = btn.innerHTML;
        btn.innerHTML = `
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Copied
        `;
        setTimeout(() => {
          btn.innerHTML = originalText;
        }, 2000);
      } catch (e) {
        // If everything fails, the mailto link in the fallback anchor will handle it
      }
    }

    btn.addEventListener('click', copyEmail);
  })();
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: calc(85svh - 64px);
    padding-block: var(--space-9);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__content {
    width: min(var(--container-w), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: 0;
  }

  .hero__ruler {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    pointer-events: none;
    z-index: 0;
  }

  @media (max-width: 1023px) {
    .hero__ruler {
      display: none;
    }
  }

  .hero__ruler-mark {
    width: 2px;
    height: 12px;
    background: var(--border);
    opacity: 0.6;
  }

  .hero__ruler-mark:nth-child(odd) {
    height: 20px;
    background: var(--signal);
    opacity: 0.3;
  }

  .hero__watermark {
    position: absolute;
    right: -60px;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.02;
    pointer-events: none;
    z-index: 0;
  }

  @media (max-width: 1023px) {
    .hero__watermark {
      display: none;
    }
  }

  .hero__status {
    margin-bottom: var(--space-5);
  }

  .hero__name {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(3.6rem, 13vw, 13rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
    white-space: nowrap;
    overflow: visible;
  }

  .hero__name .name-gradient {
    filter: drop-shadow(0 0 28px rgba(77, 124, 255, 0.35));
  }

  @media (max-width: 360px) {
    .hero__name {
      font-size: clamp(2.8rem, 14vw, 10rem);
    }
  }

  .hero__role {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--signal-soft);
    margin-top: 28px;
    margin-bottom: 20px;
  }

  .hero__bio {
    font-size: 19px;
    font-weight: 500;
    line-height: 1.65;
    color: var(--text-body);
    max-width: 56ch;
    margin-top: 0;
    margin-bottom: 36px;
  }

  @media (max-width: 767px) {
    .hero__bio {
      font-size: 18px;
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .hero__scroll-cue {
    position: absolute;
    bottom: var(--space-6);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0.6;
    animation: scroll-bounce 2s ease-in-out infinite;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  @keyframes scroll-bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-cue {
      animation: none;
    }
  }

  .ticker-section {
    padding-top: 0;
  }

  /* ============================================================
     01 WHO I AM
     ============================================================ */

  .who-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .who-grid {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }

  .who-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .who-text p {
    font-size: 18px;
    line-height: 1.75;
    color: var(--text-body);
    font-weight: 500;
    max-width: 62ch;
    margin: 0;
  }

  .who-facts {
    position: sticky;
    top: calc(var(--space-9) + 64px);
  }

  .who-facts__rows {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .who-facts__row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .who-facts__row:first-child {
    border-top: 1px solid var(--border);
  }

  .who-facts__label {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-strong);
  }

  .who-facts__value {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    text-align: right;
  }

  @media (max-width: 1023px) {
    .who-facts {
      position: static;
    }
  }

  /* ============================================================
     02 WHAT I DO
     ============================================================ */

  .whatido-rows {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .whatido-row {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    align-items: start;
    gap: var(--space-6);
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--border);
    transition: border-color 0.2s ease;
  }

  .whatido-row:first-child {
    border-top: 1px solid var(--border);
  }

  .whatido-row:hover {
    border-color: var(--signal);
  }

  .whatido-row__number {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal-soft);
    margin-top: 4px;
