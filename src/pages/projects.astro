---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import Chip from '../components/ui/Chip.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Projects"
  description="Explore my AI, ML, and automation projects including search engines, agentic systems, and web applications."
>
  <section class="projects-page" aria-labelledby="projects-heading">
    <div class="container">
      <header class="projects-page-header reveal">
        <h1 id="projects-heading" class="projects-page-title">All Projects</h1>
        <p class="projects-page-subtext">
          A collection of AI, ML, and automation projects built over 2.5+ years of self-directed learning.
        </p>
      </header>

      <div class="projects-grid grid-3" role="list">
        {projects.map((project, index) => (
          <article class="card reveal" style={`--delay: ${index + 1}`} role="listitem">
            <header class="card-header">
              <h3 class="card-title">{project.title}</h3>
              <Chip
                class={project.status === 'live' ? 'cyan' : project.status === 'in-progress' ? 'primary' : 'secondary'}
              >
                {project.status === 'coming-soon' ? 'Coming Soon' : project.status === 'in-progress' ? 'In Progress' : 'Live'}
              </Chip>
            </header>

            <div class="card-simple-words">
              <strong>In simple words:</strong> {project.simpleWords}
            </div>

            <p class="card-description">{project.description}</p>

            <div class="card-tags" role="list" aria-label="Technologies">
              {project.tags.map((tag) => (
                <Chip>{tag}</Chip>
              ))}
            </div>

            <footer class="card-footer">
              <Button
                href={`/projects/${project.slug}`}
                variant="primary"
                size="sm"
              >
                View Case Study
              </Button>
              <Button
                href={project.demoUrl || '#'}
                variant="secondary"
                size="sm"
                disabled={project.status !== 'live'}
              >
                Live Demo
              </Button>
              <Button
                href={project.codeUrl || '#'}
                variant="ghost"
                size="sm"
                disabled={project.status !== 'live'}
              >
                Code
              </Button>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>