---
import Layout from '../components/layout/Layout.astro';
import GateOverlay from '../components/layout/GateOverlay.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/globals.css';
import '../styles/transitions.css';
import '../styles/gate.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
}

const {
  title,
  description,
  ogImage = '/og-image.png',
  canonicalURL,
  ...rest
} = Astro.props;

const siteTitle = 'Rishi Sakhija';
const fullTitle = title === siteTitle ? siteTitle : `${title} | ${siteTitle}`;
const siteURL = new URL(Astro.site || 'https://rishisakhija.github.io');
const pageURL = canonicalURL ? new URL(canonicalURL, siteURL) : new URL(Astro.url.pathname, siteURL);
const imageURL = new URL(ogImage, siteURL);
---

<!doctype html>
<html lang="en" {...rest}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- View Transitions - Client Router -->
    <meta name="astro-view-transitions-enabled" content="true" />
    <ClientRouter />
  </head>
  <body>
    <!-- Deep Vignette (persists across transitions) -->
    <div class="deep-vignette" view-transition-name="deep-vignette" aria-hidden="true"></div>

    <!-- Gate Overlay (persists across transitions) -->
    <GateOverlay />

    <Layout>
      <slot />
    </Layout>

    <!-- Scripts -->
    <script type="module" src="/scripts/network-animation.js"></script>
    <script type="module" src="/scripts/terminal-animation.js"></script>
    <script type="module" src="/scripts/gate-controller.js"></script>

    <!-- Scroll Reveal & Page Initialization -->
    <script>
      function initScrollReveal() {
        const revealElements = document.querySelectorAll('.reveal:not(.visible)');

        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
        );

        revealElements.forEach((el) => revealObserver.observe(el));
      }

      function initPageComponents() {
        initScrollReveal();
        if (typeof window.initTerminal === 'function') window.initTerminal();
        if (typeof window.initNetworkAnimation === 'function') window.initNetworkAnimation();
      }

      document.addEventListener('DOMContentLoaded', initPageComponents);
      document.addEventListener('astro:page-load', initPageComponents);
      document.addEventListener('astro:after-swap', initPageComponents);
    </script>
  </body>
</html>