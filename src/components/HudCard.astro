---
interface Props {
  label?: string;
  class?: string;
  elevated?: boolean;
}

const { label, class: className = '', elevated = false } = Astro.props;
const slot = Astro.slots.has('default') ? Astro.slots.render('default') : '';
---

<style>
  .hud-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hud-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: inherit;
    border: 1px solid transparent;
    background: linear-gradient(135deg, var(--border-strong) 0%, var(--border) 100%);
    -webkit-mask: linear-gradient(135deg, #000 0%, transparent 50%);
    mask: linear-gradient(135deg, #000 0%, transparent 50%);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .hud-card--elevated:hover {
    transform: translateY(-2px);
    border-color: rgba(77, 124, 255, 0.55);
    box-shadow:
      0 0 0 1px rgba(77, 124, 255, 0.25),
      0 12px 48px -12px var(--signal-glow);
  }

  @media (prefers-reduced-motion: reduce) {
    .hud-card {
      transition: none;
    }
  }
</style>

<article class="hud-card {elevated ? 'hud-card--elevated' : ''} {className}">
  {label && <div class="hud-card__title" aria-hidden="true">{label}</div>}
  <div class="hud-card__content">
    <slot />
  </div>
</article>

<style>
  .hud-card__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-4);
    padding-left: 2px;
    position: relative;
  }

  .hud-card__title::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--signal);
    transition: width 0.2s ease;
  }

  .hud-card:hover .hud-card__title::after,
  .hud-card:focus-within .hud-card__title::after {
    width: 100%;
  }

  .hud-card__title::before {
    content: '';
    width: 12px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }
</style>