---
interface Props {
  number: number;
  label?: string;
  class?: string;
}

const { number, label, class: className = '', ...rest } = Astro.props;
const padded = number.toString().padStart(2, '0');
---

<span class={['section-number', className].filter(Boolean).join(' ')} {...rest}>
  <span class="section-number-value">{padded}</span>
  {label && <span class="section-number-label">{label}</span>}
</span>

<style>
  .section-number {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    font-weight: 500;
    color: var(--muted);
  }
  .section-number-value {
    font-weight: 600;
    color: var(--cyan);
  }
  .section-number-label {
    font-weight: 400;
    color: var(--muted);
  }
</style>