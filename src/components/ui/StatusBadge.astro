---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = '', ...rest } = Astro.props;
const classes = ['status-badge', className].filter(Boolean).join(' ');
---

<span class={classes} {...rest}>
  <span class="status-dot" aria-hidden="true"></span>
  <slot>{label}</slot>
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
    color: var(--text);
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--cyan);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--cyan), 0 0 16px rgba(0, 229, 255, 0.3);
    flex-shrink: 0;
    animation: pulse-cyan 2s ease-in-out infinite;
  }

  @keyframes pulse-cyan {
    0%, 100% { opacity: 1; transform: scale(1); box-shadow: 0 0 8px var(--cyan), 0 0 16px rgba(0, 229, 255, 0.3); }
    50% { opacity: 0.6; transform: scale(0.9); box-shadow: 0 0 4px var(--cyan), 0 0 8px rgba(0, 229, 255, 0.3); }
  }

  @media (prefers-reduced-motion: reduce) { .status-dot { animation: none; } }
</style>