const iconHtml = icons[name];

if (!iconHtml) {
  console.warn(`Icon "${name}" not found`);
}
---

{iconHtml ? (
  <span set:html={iconHtml} {...rest} />
) : (
  <span class="icon-placeholder" style="width: {size}px; height: {size}px; display: inline-block;" {...rest} />
)}