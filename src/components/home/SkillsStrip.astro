---
import { skillGroups } from '../../data/skills';
import Chip from '../ui/Chip.astro';
---

<section class="skills-strip" aria-labelledby="skills-heading">
  <div class="container">
    <h2 id="skills-heading" class="visually-hidden">Skills</h2>

    <div class="skills-groups">
      {skillGroups.map((group, groupIndex) => (
        <div class="skill-group reveal" style={`--delay: ${groupIndex + 1}`}>
          <span class="skill-group-label">{group.category}</span>
          <div class="skill-chips" role="list" aria-label={`${group.category} skills`}>
            {group.skills.map((skill) => (
              <Chip role="listitem">{skill}</Chip>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-strip {
    padding: var(--space-3xl) 0;
    background-color: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .skills-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-xl);
  }

  .skill-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .skill-group-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>