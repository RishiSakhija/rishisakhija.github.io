---
import Terminal from './Terminal.astro';
import StatusBadge from '../ui/StatusBadge.astro';
import Button from '../ui/Button.astro';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-network" aria-hidden="true">
    <canvas id="network-canvas" data-network-canvas></canvas>
  </div>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="deep-vignette" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-content">
      <div class="hero-badge">
        <StatusBadge label="open to work · remote" />
      </div>

      <h1 id="hero-heading" class="hero-name" aria-label="Rishi Sakhija">
        <span class="wordmark">
          <span class="wordmark-part wordmark-rishi">Rishi</span>
          <span class="wordmark-part wordmark-sakhija">Sakhija</span>
        </span>
        <span class="sr-only">Rishi Sakhija</span>
      </h1>

      <p class="hero-role">
        <span class="cyan-dot" aria-hidden="true"></span>
        AI/ML builder in the making · Agents & Automation
      </p>

      <p class="hero-subtext">
        Self-taught for 2.5+ years, I design and build AI agents, search systems, and automation that turn complex work into simple workflows.
      </p>

      <div class="hero-actions">
        <Button href="/projects" variant="primary" size="lg">
          View Projects
        </Button>
        <Button href="/contact" variant="secondary" size="lg">
          Get in Touch
        </Button>
      </div>

      <div class="hero-stats">
        <span class="stat">2.5+ yrs building</span>
        <span class="stat-divider" aria-hidden="true">|</span>
        <span class="stat">3 projects</span>
        <span class="stat-divider" aria-hidden="true">|</span>
        <span class="stat">remote · open to work</span>
      </div>
    </div>

    <aside class="hero-terminal" aria-label="Terminal simulation">
      <Terminal />
    </aside>
  </div>
</section>

<script is:inline>
  // Add .js class immediately for progressive enhancement
  document.documentElement.classList.add('js');
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: var(--space-4xl) 0;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3xl);
    align-items: start;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr 420px;
      gap: var(--space-4xl);
    }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 48ch;
  }

  .hero-badge {
    margin-bottom: var(--space-lg);
  }

  .hero-name {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.05;
    margin-bottom: var(--space-md);
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0;
  }

  .js .wordmark {
    opacity: 0;
    animation: wordmark-reveal var(--transition-scan) forwards;
  }

  .wordmark-part {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--fs-hero);
    line-height: 1.05;
  }

  .wordmark-rishi { color: var(--text); }

  .wordmark-sakhija {
    background: linear-gradient(135deg, var(--amethyst-soft) 0%, var(--amethyst) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @keyframes wordmark-reveal {
    from { opacity: 0; transform: translateY(1.5rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .wordmark { animation: none; opacity: 1; transform: none; }
  }

  .hero-role {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--muted);
    margin-bottom: var(--space-lg);
  }

  .cyan-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--cyan);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--cyan), 0 0 16px rgba(0, 229, 255, 0.3);
    flex-shrink: 0;
    animation: pulse-cyan 2s ease-in-out infinite;
  }

  @keyframes pulse-cyan {
    0%, 100% { opacity: 1; transform: scale(1); box-shadow: 0 0 8px var(--cyan), 0 0 16px rgba(0, 229, 255, 0.3); }
    50% { opacity: 0.6; transform: scale(0.9); box-shadow: 0 0 4px var(--cyan), 0 0 8px rgba(0, 229, 255, 0.3); }
  }

  @media (prefers-reduced-motion: reduce) { .cyan-dot { animation: none; } }

  .hero-subtext {
    font-size: var(--fs-body);
    color: var(--muted);
    max-width: 48ch;
    margin-bottom: var(--space-xl);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  @media (max-width: 640px) {
    .hero-actions { flex-direction: column; }
    .hero-actions .btn { width: 100%; }
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--muted);
  }

  .stat-divider { opacity: 0.4; }

  .hero-terminal {
    position: sticky;
    top: var(--space-2xl);
    height: fit-content;
  }

  @media (max-width: 1023px) {
    .hero-terminal { position: static; margin-top: var(--space-2xl); }
  }

  /* Network Canvas */
  .hero-network {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
  .hero-network canvas { display: block; width: 100%; height: 100%; }

  /* Glow & Vignette */
  .hero-glow {
    position: fixed;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80vw;
    max-width: 800px;
    height: 60vh;
    background: radial-gradient(ellipse at center, rgba(123, 63, 228, 0.06) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }

  .deep-vignette {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 50%;
    height: 50%;
    background: radial-gradient(ellipse at bottom right, rgba(75, 29, 150, 0.15) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow, .deep-vignette { display: none; }
  }

  @media (max-width: 1023px) {
    .hero-inner { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .hero { padding: var(--space-3xl) 0; min-height: auto; }
    .hero-name { font-size: clamp(2.5rem, 10vw, 4rem); }
    .hero-subtext { font-size: var(--fs-body); }
    .hero-stats { flex-direction: column; align-items: flex-start; gap: var(--space-xs); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow, .deep-vignette { display: none; }
  }
</style>