---
import { agentData } from '../../data/agents';
import Chip from '../ui/Chip.astro';
import Icon from '../ui/Icon.astro';
---

<section class="agent-hq" aria-labelledby="agent-hq-heading">
  <div class="container">
    <header class="section-header reveal">
      <h2 id="agent-hq-heading" class="section-title">Agent HQ</h2>
      <p class="section-subtext">agentic team · in development</p>
    </header>

    <p class="hq-note reveal" style="--delay: 1">
      A visual of the personal agentic team I am building.
    </p>

    <div class="hq-grid">
      {agentData.map((agent, idx) => (
        <article class="agent-card reveal" style={`--delay: ${idx + 1}`} aria-labelledby={`agent-${agent.id}-name`}>
          <div class="agent-icon" aria-hidden="true">
            <Icon name={agent.id} size={48} />
          </div>
          <h3 id={`agent-${agent.id}-name`} class="agent-name">{agent.name}</h3>
          <p class="agent-role">{agent.role}</p>
          <Chip variant={agent.status === 'online' ? 'cyan' : 'secondary'} class="agent-status">
            {agent.status}
          </Chip>
        </article>
      ))}
    </div>

    <div class="hq-connectors" aria-hidden="true" role="img" aria-label="Connections from CEO to team members">
      <svg class="connector-svg" viewBox="0 0 800 400" preserveAspectRatio="none">
        <defs>
          <linearGradient id="connector-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0.4"/>
            <stop offset="50%" stop-color="var(--amethyst)" stop-opacity="0.4"/>
            <stop offset="100%" stop-color="var(--cyan)" stop-opacity="0.4"/>
          </linearGradient>
        </defs>
        <path class="connector-path" d="M400,180 C400,220 100,220 100,180" stroke="url(#connector-gradient)" stroke-width="1.5" fill="none" stroke-dasharray="4,4">
          <animate attributeName="stroke-dashoffset" from="0" to="20" dur="2s" repeatCount="indefinite" />
        </path>
        <path class="connector-path" d="M400,180 C400,220 400,280 400,280" stroke="url(#connector-gradient)" stroke-width="1.5" fill="none" stroke-dasharray="4,4">
          <animate attributeName="stroke-dashoffset" from="0" to="20" dur="2s" repeatCount="indefinite" />
        </path>
        <path class="connector-path" d="M400,180 C400,220 700,220 700,180" stroke="url(#connector-gradient)" stroke-width="1.5" fill="none" stroke-dasharray="4,4">
          <animate attributeName="stroke-dashoffset" from="0" to="20" dur="2s" repeatCount="indefinite" />
        </path>
        <circle class="pulse" cx="400" cy="180" r="4" fill="var(--cyan)" opacity="0">
          <animate attributeName="r" from="4" to="16" dur="1.5s" repeatCount="indefinite" />
          <animate attributeName="opacity" from="0.6" to="0" dur="1.5s" repeatCount="indefinite" />
        </circle>
        <circle class="pulse" cx="100" cy="180" r="4" fill="var(--cyan)" opacity="0">
          <animate attributeName="r" from="4" to="16" dur="1.5s" repeatCount="indefinite" begin="0.5s" />
          <animate attributeName="opacity" from="0.6" to="0" dur="1.5s" repeatCount="indefinite" begin="0.5s" />
        </circle>
        <circle class="pulse" cx="400" cy="280" r="4" fill="var(--cyan)" opacity="0">
          <animate attributeName="r" from="4" to="16" dur="1.5s" repeatCount="indefinite" begin="0.25s" />
          <animate attributeName="opacity" from="0.6" to="0" dur="1.5s" repeatCount="indefinite" begin="0.25s" />
        </circle>
        <circle class="pulse" cx="700" cy="180" r="4" fill="var(--cyan)" opacity="0">
          <animate attributeName="r" from="4" to="16" dur="1.5s" repeatCount="indefinite" begin="0.75s" />
          <animate attributeName="opacity" from="0.6" to="0" dur="1.5s" repeatCount="indefinite" begin="0.75s" />
        </circle>
      </svg>
    </div>

    <div class="activity-log reveal" style="--delay: 5">
      <h3 class="log-title">Activity Log</h3>
      <div class="log-entries" data-log-entries>
        <div class="log-entry">> ceo: task received</div>
        <div class="log-entry">> ceo: assigning research</div>
        <div class="log-entry">> research: collecting sources...</div>
        <div class="log-entry">> analysis: summarizing findings</div>
        <div class="log-entry">> content: draft ready</div>
      </div>
    </div>
  </div>
</section>

<style>
  .agent-hq { padding: var(--space-3xl) 0; }
  .section-subtext { color: var(--muted); font-size: var(--fs-mono); font-family: var(--font-mono); margin-top: var(--space-xs); }
  .hq-note { color: var(--muted); font-size: var(--fs-body-sm); max-width: 48ch; }
  .hq-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-lg); margin: var(--space-2xl) 0; position: relative; z-index: 1; }
  .agent-card { padding: var(--space-lg); text-align: center; position: relative; z-index: 2; }
  .agent-icon { width: 4rem; height: 4rem; margin: 0 auto var(--space-md); color: var(--amethyst); display: flex; align-items: center; justify-content: center; }
  .agent-name { font-size: var(--fs-h4); margin-bottom: var(--space-xs); }
  .agent-role { color: var(--muted); font-size: var(--fs-body-sm); margin-bottom: var(--space-md); }
  .agent-status { margin-top: var(--space-sm); }
  .hq-connectors { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; z-index: 1; }
  .connector-svg { width: 100%; height: 100%; position: absolute; top: 0; left: 0; }
  .connector-path { stroke-linecap: round; stroke-linejoin: round; }
  .pulse { filter: blur(1px); }
  .activity-log { margin-top: var(--space-2xl); padding: var(--space-lg); background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .log-title { font-family: var(--font-mono); font-size: var(--fs-mono); color: var(--cyan); margin-bottom: var(--space-md); text-align: center; }
  .log-entries { font-family: var(--font-mono); font-size: var(--fs-mono); color: var(--text-dim); line-height: 2; }
  .log-entry::before { content: '> '; color: var(--cyan); }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } .connector-path { animation: none; } }
  @media (max-width: 768px) { .hq-grid { grid-template-columns: 1fr; } .hq-connectors { display: none; } }
</style>