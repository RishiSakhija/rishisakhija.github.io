---
import { projects } from '../../data/projects';
import Chip from '../ui/Chip.astro';
import Button from '../ui/Button.astro';

const featuredProjects = projects.slice(0, 3);
---

<section class="featured-projects" aria-labelledby="featured-heading">
  <div class="container">
    <header class="section-header reveal">
      <h2 id="featured-heading" class="section-title">Featured Projects</h2>
      <a href="/projects" class="section-link">
        View all
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </header>

    <div class="projects-grid grid-3" role="list">
      {featuredProjects.map((project, index) => (
        <article class="card reveal" style={`--delay: ${index + 1}`} role="listitem">
          <header class="card-header">
            <h3 class="card-title">{project.title}</h3>
            <Chip
              class={project.status === 'live' ? 'cyan' : project.status === 'in-progress' ? 'primary' : 'secondary'}
            >
              {project.status === 'coming-soon' ? 'Coming Soon' : project.status === 'in-progress' ? 'In Progress' : 'Live'}
            </Chip>
          </header>

          <div class="card-simple-words">
            <strong>In simple words:</strong> {project.simpleWords}
          </div>

          <p class="card-description">{project.description}</p>

          <div class="card-tags" role="list" aria-label="Technologies">
            {project.tags.map((tag) => (
              <Chip>{tag}</Chip>
            ))}
          </div>

          <footer class="card-footer">
            <Button
              href={`/projects/${project.slug}`}
              variant="primary"
              size="sm"
            >
              View Case Study
            </Button>
            <Button
              href={project.demoUrl || '#'}
              variant="secondary"
              size="sm"
              disabled={project.status !== 'live'}
            >
              Live Demo
            </Button>
            <Button
              href={project.codeUrl || '#'}
              variant="ghost"
              size="sm"
              disabled={project.status !== 'live'}
            >
              Code
            </Button>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>