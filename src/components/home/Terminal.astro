---
import { terminalScript } from '../../data/terminal';
---

<div
  class="terminal"
  id="terminal"
  role="region"
  aria-label="Terminal simulation showing AI agent workflow commands and outputs"
  aria-live="off"
  data-terminal-root
>
  <!-- Animated Terminal (default) -->
  <div class="terminal-animated" data-terminal-animated>
    <header class="terminal-header">
      <div class="terminal-dots" aria-hidden="true">
        <span class="terminal-dot" style="background: var(--red); box-shadow: 0 0 8px var(--red-glow);"></span>
        <span class="terminal-dot" style="background: var(--amber);"></span>
        <span class="terminal-dot" style="background: var(--green);"></span>
      </div>
      <span class="terminal-title">rishi@agent-hq: ~</span>
      <div style="width: 48px;"></div>
    </header>
    <div class="terminal-body" data-terminal-body>
      <!-- Lines injected by terminal-animation.js -->
    </div>
  </div>

  <!-- Static Fallback (reduced motion / no JS) -->
  <div class="terminal-static" data-terminal-static hidden>
    <header class="terminal-header">
      <div class="terminal-dots" aria-hidden="true">
        <span class="terminal-dot" style="background: var(--red);"></span>
        <span class="terminal-dot" style="background: var(--amber);"></span>
        <span class="terminal-dot" style="background: var(--green);"></span>
      </div>
      <span class="terminal-title">rishi@agent-hq: ~</span>
      <div style="width: 48px;"></div>
    </header>
    <div class="terminal-body">
      {terminalScript.map((line, i) => (
        <div class="terminal-line" data-line-index={i}>
          {line.type === 'command' && (
            <>
              <span class="terminal-prompt">{line.prompt || '$'}</span>
              <span class="terminal-command">{line.text}</span>
            </>
          )}
          {line.type === 'output' && (
            <span class="terminal-output">{line.text}</span>
          )}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .terminal {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg), var(--shadow-blue);
    max-width: 100%;
    width: 100%;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-md);
    background: var(--surface-elevated);
    border-bottom: 1px solid var(--border);
  }

  .terminal-dots {
    display: flex;
    gap: var(--space-xs);
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--border);
    transition: background var(--transition-fast);
  }

  .terminal-title {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    color: var(--muted);
    flex: 1;
    text-align: center;
  }

  .terminal-body {
    padding: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    line-height: 1.6;
    color: var(--text);
    min-height: 200px;
    max-height: 400px;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .terminal-body {
      min-height: 160px;
      max-height: 300px;
    }
  }

  .terminal-line {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .terminal-line:last-child {
    margin-bottom: 0;
  }

  .terminal-prompt {
    color: var(--blue);
    flex-shrink: 0;
    user-select: none;
  }

  .terminal-command {
    color: var(--text);
    user-select: none;
  }

  .terminal-output {
    color: var(--muted);
    user-select: none;
  }

  .terminal-output .highlight {
    color: var(--blue-soft);
  }

  .terminal-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1em;
    background: var(--red);
    margin-left: 2px;
    animation: cursor-blink 1s step-end infinite;
    vertical-align: text-bottom;
  }

  @keyframes cursor-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-cursor {
      animation: none;
      opacity: 1;
    }
  }

  /* Static Fallback */
  .terminal-static {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-animated {
      display: none;
    }
    .terminal-static {
      display: block;
    }
  }

  .no-js .terminal-animated {
    display: none;
  }

  .no-js .terminal-static {
    display: block;
  }

  /* Terminal Scrollbar */
  .terminal-body::-webkit-scrollbar {
    width: 6px;
  }

  .terminal-body::-webkit-scrollbar-track {
    background: var(--bg);
  }

  .terminal-body::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 3px;
  }

  .terminal-body::-webkit-scrollbar-thumb:hover {
    background: var(--muted);
  }
</style>