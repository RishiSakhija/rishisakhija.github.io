---
interface Props {
  contentTeasers: any[];
}

const { contentTeasers } = Astro.props;
---

<section class="latest-content" aria-labelledby="latest-heading">
  <div class="container">
    <header class="section-header reveal">
      <h2 id="latest-heading" class="section-title">Latest</h2>
    </header>

    <div class="latest-grid">
      {contentTeasers.map((teaser, index) => (
        <article class="placeholder-card reveal" style={`--delay: ${index + 1}`}>
          <div class="placeholder-icon" aria-hidden="true" set:html={teaser.data.icon} />
          <span class="chip primary" style="margin-bottom: var(--space-md);">{teaser.data.label}</span>
          <h3 class="placeholder-title">{teaser.data.title}</h3>
          <p class="placeholder-text">{teaser.data.text}</p>
          <div class="placeholder-chips">
            {teaser.data.chips.map((chip: string) => (
              <span class="chip">{chip}</span>
            ))}
          </div>
          <a href={teaser.data.href} class="btn btn-secondary btn-block">Explore {teaser.data.label}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .latest-content { padding: var(--space-3xl) 0; background: var(--surface); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .latest-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-lg); }
  .placeholder-card { padding: var(--space-xl); background: var(--surface-elevated); border: 1px dashed var(--border); border-radius: var(--radius-lg); text-align: center; transition: all var(--transition-base); }
  .placeholder-card:hover { border-color: var(--blue); border-style: solid; box-shadow: var(--shadow-blue); }
  .placeholder-icon { width: 3rem; height: 3rem; margin: 0 auto var(--space-md); color: var(--blue); opacity: 0.5; display: flex; align-items: center; justify-content: center; }
  .placeholder-title { font-size: var(--fs-h4); margin-bottom: var(--space-sm); }
  .placeholder-text { color: var(--muted); font-size: var(--fs-body-sm); margin-bottom: var(--space-lg); }
  .placeholder-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-sm); margin-bottom: var(--space-lg); }
  @media (prefers-reduced-motion: reduce) { .placeholder-card { transition: none; } .placeholder-card:hover { transform: none; } }
</style>