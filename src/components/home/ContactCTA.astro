---
import Button from '../ui/Button.astro';
---

<section class="contact-cta" aria-labelledby="contact-cta-heading">
  <div class="container">
    <h2 id="contact-cta-heading" class="contact-cta-title reveal">
      Let's build something together
    </h2>
    <p class="contact-cta-text reveal" style="--delay: 1">
      Open to opportunities, collaborations, and conversations about AI.
    </p>
    <div class="contact-cta-actions reveal" style="--delay: 2">
      <Button href="/contact" variant="primary" size="lg">
        Get in Touch
      </Button>
      <Button href="/projects" variant="secondary" size="lg">
        View Projects
      </Button>
    </div>
  </div>
</section>

<style>
  .contact-cta {
    padding: var(--space-4xl) 0;
    text-align: center;
  }

  .contact-cta-title {
    margin-bottom: var(--space-sm);
  }

  .contact-cta-text {
    color: var(--muted);
    max-width: 40ch;
    margin: 0 auto var(--space-xl);
    font-size: var(--fs-hero-sub);
  }

  .contact-cta-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
</style>