---
import { tickerItemsLooped } from '../../data/ticker';
---

<section class="ticker-band" aria-hidden="true" role="region" aria-label="Skills and projects ticker">
  <div class="ticker-track" data-ticker-track>
    {tickerItemsLooped.map((item, i) => (
      <span class="ticker-item" data-index={i}>
        {item}
        <span class="ticker-sep" aria-hidden="true">·</span>
      </span>
    ))}
  </div>
</section>

<style>
  .ticker-band {
    width: 100%;
    overflow: hidden;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: var(--space-md) 0;
  }

  .ticker-track {
    display: flex;
    gap: var(--space-xl);
    white-space: nowrap;
    will-change: transform;
    animation: ticker-scroll 40s linear infinite;
  }

  .ticker-item {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--muted);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
  }

  .ticker-sep {
    color: var(--cyan);
    opacity: 0.5;
  }

  @keyframes ticker-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .ticker-band:hover .ticker-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }
</style>