---
/**
 * How I Work - Three principle cards
 */

const principles = [
  {
    icon: `
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M12 2L2 7l10 5 10-5-10-5z"/>
        <path d="M2 17l10 5 10-5"/>
        <path d="M2 12l10 5 10-5"/>
      </svg>
    `,
    title: 'Build',
    text: 'Ship small, useful things constantly. Working code > perfect plans. Every project starts as a prototype and earns its way to production.',
  },
  {
    icon: `
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
        <path d="M4 12h16"/>
        <path d="M12 4v16"/>
      </svg>
    `,
    title: 'Automate',
    text: 'If I do it twice, I automate it. Agents, scripts, and workflows handle the repetitive so I can focus on the novel. The goal is leverage, not just speed.',
  },
  {
    icon: `
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
    `,
    title: 'Learn in Public',
    text: 'Write, share, and document as I go. Mistakes become lessons. The feedback loop with the community compounds faster than any solo study.',
  },
];
---

<section class="how-i-work" aria-labelledby="how-i-work-heading">
  <div class="container">
    <header class="section-header reveal">
      <h2 id="how-i-work-heading" class="section-title">How I Work</h2>
    </header>

    <div class="how-i-work-cards">
      {principles.map((principle, index) => (
        <article class="card how-card reveal" style={`--delay: ${index + 1}`}>
          <div class="how-card-icon" aria-hidden="true">
            {principle.icon}
          </div>
          <h3 class="how-card-title">{principle.title}</h3>
          <p class="how-card-text">{principle.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .how-i-work {
    padding: var(--space-3xl) 0;
  }

  .how-i-work-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-lg);
  }

  .how-card {
    padding: var(--space-xl);
    text-align: center;
    transition: all var(--transition-base);
  }

  .how-card:hover {
    border-color: var(--blue);
    box-shadow: var(--shadow-blue);
    transform: translateY(-4px);
  }

  .how-card-icon {
    width: 3rem;
    height: 3rem;
    margin: 0 auto var(--space-lg);
    color: var(--blue);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .how-card-title {
    font-size: var(--fs-h4);
    margin-bottom: var(--space-sm);
  }

  .how-card-text {
    color: var(--muted);
    font-size: var(--fs-body-sm);
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .how-card {
      transition: none;
    }
    .how-card:hover {
      transform: none;
    }
  }
</style>