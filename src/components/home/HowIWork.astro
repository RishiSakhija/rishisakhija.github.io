---
interface Props {
  principles: any[];
}

const { principles } = Astro.props;
---

<section class="how-i-work" aria-labelledby="how-i-work-heading">
  <div class="container">
    <header class="section-header reveal">
      <h2 id="how-i-work-heading" class="section-title">How I Work</h2>
    </header>

    <div class="how-i-work-cards">
      {principles.map((principle, index) => (
        <article class="card how-card reveal" style={`--delay: ${index + 1}`}>
          <div class="how-card-icon" aria-hidden="true" set:html={principle.data.icon} />
          <h3 class="how-card-title">{principle.data.title}</h3>
          <p class="how-card-text">{principle.data.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .how-i-work { padding: var(--space-3xl) 0; }
  .how-i-work-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-lg); }
  .how-card { padding: var(--space-xl); text-align: center; transition: all var(--transition-base); }
  .how-card:hover { border-color: var(--blue); box-shadow: var(--shadow-blue); transform: translateY(-4px); }
  .how-card-icon { width: 3rem; height: 3rem; margin: 0 auto var(--space-lg); color: var(--blue); display: flex; align-items: center; justify-content: center; }
  .how-card-title { font-size: var(--fs-h4); margin-bottom: var(--space-sm); }
  .how-card-text { color: var(--muted); font-size: var(--fs-body-sm); line-height: 1.6; }
  @media (prefers-reduced-motion: reduce) { .how-card { transition: none; } .how-card:hover { transform: none; } }
</style>