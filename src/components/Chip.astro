---
interface Props {
  variant?: 'default' | 'status' | 'tag';
  status?: 'in-progress' | 'planned' | 'live';
  class?: string;
}

const { variant = 'default', status, class: className = '' } = Astro.props;
---

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .chip--default {
    padding: var(--space-1) var(--space-3);
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--muted-strong);
  }

  .chip--status {
    padding: var(--space-1) var(--space-3);
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted-strong);
  }

  .chip--tag {
    padding: var(--space-1) var(--space-2);
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted-strong);
    font-size: 11px;
  }

  .chip--status--in-progress {
    border-color: var(--signal);
    color: var(--muted-strong);
  }

  .chip--status--planned {
    border-color: var(--muted);
    color: var(--muted-strong);
  }

  .chip--status--live {
    border-color: var(--signal);
    color: var(--signal);
  }

  .chip__status {
    margin-left: var(--space-2);
    color: var(--signal-soft);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
  }
</style>

<span class="chip chip--{variant} {status ? `chip--status--{status}` : ''} {className}">
  <slot />
</span>