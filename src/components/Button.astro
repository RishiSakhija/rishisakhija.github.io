---
interface Props {
  variant?: 'primary' | 'secondary';
  href?: string;
  disabled?: boolean;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  ariaLabel?: string;
}

const { variant = 'primary', href, disabled = false, class: className = '', type = 'button', ariaLabel } = Astro.props;
const slot = Astro.slots.has('default') ? Astro.slots.render('default') : '';
const isLink = !!href && !disabled;
const classes = `btn btn--${variant} ${disabled ? 'btn--disabled' : ''} ${className}`;
---

{isLink ? (
  <a class={classes} href={href} aria-label={ariaLabel}>
    <slot />
  </a>
) : (
  <button class={classes} disabled={disabled ? true : undefined} aria-label={ariaLabel} type={type} aria-disabled={disabled ? 'true' : undefined}>
    <slot />
  </button>
)}