---
interface Props {
  variant?: 'primary' | 'secondary';
  href?: string;
  disabled?: boolean;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  ariaLabel?: string;
}

const { variant = 'primary', href, disabled = false, class: className = '', type = 'button', ariaLabel } = Astro.props;
const slot = Astro.slots.has('default') ? Astro.slots.render('default') : '';
const isLink = !!href && !disabled;
const Tag = isLink ? 'a' : 'button';
---

<Tag
  class="btn btn--{variant} {disabled ? 'btn--disabled' : ''} {className}"
  href={isLink ? href : undefined}
  disabled={disabled ? true : undefined}
  aria-label={ariaLabel}
  type={!isLink ? type : undefined}
  aria-disabled={disabled ? 'true' : undefined}
>
  <slot />
</Tag>