---
interface Props {
  variant?: 'primary' | 'secondary';
  href?: string;
  disabled?: boolean;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  ariaLabel?: string;
}

const { variant = 'primary', href, disabled = false, class: className = '', type = 'button', ariaLabel } = Astro.props;
const slot = Astro.slots.has('default') ? Astro.slots.render('default') : '';
const isLink = !!href && !disabled;
const Tag = isLink ? 'a' : 'button';
---

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-card);
    border: 1px solid transparent;
    transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
    white-space: nowrap;
    min-width: 140px;
  }

  .btn:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }

  .btn:active:not(:disabled) {
    transform: scale(0.98);
  }

  .btn--primary {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .btn--primary:hover:not(:disabled) {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--bg);
  }

  .btn--secondary {
    background: transparent;
    color: var(--text);
    border-color: var(--border);
  }

  .btn--secondary:hover:not(:disabled) {
    border-color: var(--signal);
    color: var(--signal);
    background: var(--signal-glow);
  }

  .btn--disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .btn--disabled:hover {
    transform: none;
    background: inherit;
    border-color: inherit;
    color: inherit;
  }
</style>

<Tag
  class="btn btn--{variant} {disabled ? 'btn--disabled' : ''} {className}"
  href={isLink ? href : undefined}
  disabled={disabled ? true : undefined}
  aria-label={ariaLabel}
  type={!isLink ? type : undefined}
  aria-disabled={disabled ? 'true' : undefined}
>
  <slot />
</Tag>