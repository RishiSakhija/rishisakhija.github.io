---
import RSLogo from './RSLogo.astro';
import Button from './Button.astro';
---

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 10001;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-8);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .intro--active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .intro__logo-ring {
    position: relative;
    width: clamp(100px, 20vw, 160px);
    height: clamp(100px, 20vw, 160px);
  }

  .intro__logo-ring svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .intro__logo-ring circle {
    fill: none;
    stroke: color-mix(in srgb, var(--text) 85%, transparent);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .intro__logo-ring .intro__ring-track {
    opacity: 0.15;
  }

  .intro__logo-ring .intro__ring-progress {
    stroke: var(--signal);
    stroke-dasharray: 472;
    stroke-dashoffset: 472;
    transition: stroke-dashoffset 2.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .intro__logo-ring--complete .intro__ring-progress {
    stroke-dashoffset: 0;
  }

  .intro__logo-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .intro__logo-center .rs-logo {
    transform: scale(0);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 2.2s;
  }

  .intro__logo-ring--complete .intro__logo-center .rs-logo {
    transform: scale(1);
  }

  .intro__status {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-fade);
    min-height: 60px;
  }

  .intro__status-line {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    white-space: nowrap;
  }

  .intro__status-line--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .intro__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .intro__status-line--live .intro__status-dot {
    background: var(--data);
    box-shadow: 0 0 8px var(--data-glow);
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .intro__guide {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s ease 2.8s, transform 0.4s ease 2.8s;
  }

  .intro__guide--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .intro__guide-greeting {
    font-family: var(--font-body);
    font-size: clamp(16px, 3vw, 20px);
    line-height: 1.5;
    color: var(--text);
    max-width: 40ch;
  }

  .intro__guide-topics {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  .intro__topic-btn {
    padding: var(--space-2) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-fade);
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .intro__topic-btn:hover {
    border-color: var(--signal);
    color: var(--signal);
    background: var(--surface-2);
  }

  .intro__topic-btn:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 2px;
  }

  .intro__skip {
    position: absolute;
    bottom: var(--space-6);
    left: 50%;
    transform: translateX(-50%);
    padding: var(--space-2) var(--space-5);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .intro__skip:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  .intro__skip:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__logo-ring .intro__ring-progress,
    .intro__logo-center .rs-logo,
    .intro__status-line,
    .intro__guide {
      transition: none;
    }
    .intro__logo-ring--complete .intro__ring-progress {
      stroke-dashoffset: 0;
    }
    .intro__logo-ring--complete .intro__logo-center .rs-logo {
      transform: scale(1);
    }
    .intro__status-line {
      opacity: 1;
      transform: none;
    }
    .intro__guide {
      opacity: 1;
      transform: none;
    }
  }
</style>

<div class="intro js-only" id="intro" role="dialog" aria-modal="true" aria-label="Welcome to Rishi's portfolio">
  <div class="intro__logo-ring" id="intro-ring" aria-hidden="true">
    <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
      <circle class="intro__ring-track" cx="60" cy="60" r="55"/>
      <circle class="intro__ring-progress" cx="60" cy="60" r="55"/>
    </svg>
    <div class="intro__logo-center">
      <RSLogo size={56} />
    </div>
  </div>

  <div class="intro__status" aria-live="polite" aria-atomic="true">
    <div class="intro__status-line" id="intro-line-1">
      <span class="intro__status-dot" aria-hidden="true"></span>
      <span>initializing core systems...</span>
    </div>
    <div class="intro__status-line" id="intro-line-2">
      <span class="intro__status-dot" aria-hidden="true"></span>
      <span>booting agents...</span>
    </div>
    <div class="intro__status-line" id="intro-line-3">
      <span class="intro__status-dot" aria-hidden="true"></span>
      <span>establishing secure channel...</span>
    </div>
    <div class="intro__status-line" id="intro-line-4">
      <span class="intro__status-dot" aria-hidden="true"></span>
      <span>all systems online</span>
    </div>
  </div>

  <div class="intro__guide" id="intro-guide">
    <p class="intro__guide-greeting">Welcome to Rishi's control room. I'm RS Guide. What would you like to explore first?</p>
    <div class="intro__guide-topics" role="list" aria-label="Topics to explore">
      <button class="intro__topic-btn" data-target="/about" role="listitem">Story</button>
      <button class="intro__topic-btn" data-target="/projects" role="listitem">Work</button>
      <button class="intro__topic-btn" data-target="/skills" role="listitem">Skills</button>
      <button class="intro__topic-btn" data-target="/contact" role="listitem">Contact</button>
    </div>
  </div>

  <button class="intro__skip" id="intro-skip" aria-label="Skip introduction">Skip</button>
</div>

<script>
  (() => {
    const intro = document.getElementById('intro');
    if (!intro) return;

    const ring = document.getElementById('intro-ring');
    const lines = [
      document.getElementById('intro-line-1'),
      document.getElementById('intro-line-2'),
      document.getElementById('intro-line-3'),
      document.getElementById('intro-line-4'),
    ];
    const guide = document.getElementById('intro-guide');
    const skipBtn = document.getElementById('intro-skip');
    const topicBtns = intro.querySelectorAll('.intro__topic-btn');

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hasSeenIntro = (() => {
      try {
        return localStorage.getItem('intro-seen') === '1';
      } catch {
        return false;
      }
    })();

    let completed = false;
    let timers = [];

    function clearTimers() {
      timers.forEach(t => clearTimeout(t));
      timers = [];
    }

    function markSeen() {
      try {
        localStorage.setItem('intro-seen', '1');
      } catch {}
    }

    function skipIntro() {
      if (completed) return;
      completed = true;
      clearTimers();
      markSeen();
      intro.classList.remove('intro--active');
      intro.addEventListener('transitionend', () => {
        intro.style.display = 'none';
      }, { once: true });
      document.body.style.overflow = '';
    }

    function navigateTo(href) {
      skipIntro();
      window.location.assign(href);
    }

    function runSequence() {
      if (hasSeenIntro) {
        intro.style.display = 'none';
        return;
      }

      document.body.style.overflow = 'hidden';
      intro.style.display = 'flex';
      requestAnimationFrame(() => {
        intro.classList.add('intro--active');
      });

      if (prefersReduced) {
        ring.classList.add('intro__logo-ring--complete');
        lines.forEach(l => l.classList.add('intro__status-line--visible', 'intro__status-line--live'));
        lines.forEach(l => l.querySelector('.intro__status-dot').classList.add('intro__status-line--live'));
        guide.classList.add('intro__guide--visible');
        completed = true;
        markSeen();
        return;
      }

      ring.classList.add('intro__logo-ring--complete');

      const lineDelays = [0, 500, 1000, 1600];
      lines.forEach((line, i) => {
        timers.push(setTimeout(() => {
          line.classList.add('intro__status-line--visible');
          if (i === lines.length - 1) {
            line.classList.add('intro__status-line--live');
            line.querySelector('.intro__status-dot').classList.add('intro__status-line--live');
          }
        }, lineDelays[i]));
      });

      timers.push(setTimeout(() => {
        guide.classList.add('intro__guide--visible');
      }, 2800));

      timers.push(setTimeout(() => {
        completed = true;
        markSeen();
      }, 3500));
    }

    function init() {
      skipBtn.addEventListener('click', skipIntro);
      topicBtns.forEach(btn => {
        btn.addEventListener('click', () => navigateTo(btn.dataset.target));
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && intro.classList.contains('intro--active')) {
          skipIntro();
        }
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', runSequence, { once: true });
      } else {
        runSequence();
      }
    }

    function cleanup() {
      clearTimers();
      document.removeEventListener('keydown', (e) => {});
    }

    init();
    window.addEventListener('pagehide', cleanup, { once: true });
  })();
</script>