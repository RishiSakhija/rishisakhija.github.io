---
import { contactLinks } from '../../data/contact';

interface Props {
  index: number;
}

const { index } = Astro.props;
const link = contactLinks[index];

function getIcon(name: string): string {
  switch (name) {
    case 'mail':
      return '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>';
    case 'github':
      return '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>';
    case 'linkedin':
      return '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>';
    default:
      return '';
  }
}
---

<a
  href={link.href}
  class={`contact-link ${link.status === 'coming-soon' ? 'coming-soon' : ''}`}
  aria-label={link.label}
  target={link.href.startsWith('http') ? '_blank' : undefined}
  rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
  aria-disabled={link.status === 'coming-soon'}
>
  <svg class="contact-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={getIcon(link.icon)} />
  <span>{link.label}</span>
  {link.status === 'coming-soon' && <span class="coming-soon-badge">Coming soon</span>}
</a>

<style>
  .contact-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    width: 100%;
    padding: var(--space-md) var(--space-lg);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .contact-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: rgba(77, 226, 197, 0.05);
    transform: translateY(-2px);
    box-shadow: var(--shadow-accent);
  }

  .contact-link.coming-soon {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .contact-link.coming-soon:hover {
    transform: none;
    border-color: var(--border);
    color: var(--muted);
    background-color: var(--surface);
    box-shadow: none;
  }

  .contact-link-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--muted);
    transition: color var(--transition-fast);
  }

  .contact-link:hover .contact-link-icon {
    color: var(--accent);
  }

  .coming-soon-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    background-color: var(--surface);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link,
    .contact-link-icon {
      transition: none;
    }
  }
</style>