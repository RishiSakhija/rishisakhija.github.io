<div class="scan-line" aria-hidden="true" view-transition-name="scan-line"></div>

<style>
  .scan-line {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
    transform: translateX(-100%);
    z-index: var(--z-nav);
    pointer-events: none;
    opacity: 0;
  }

  .scan-line.active {
    animation: scan-line-cross var(--transition-scan) ease forwards;
  }

  @keyframes scan-line-cross {
    0% { transform: translateX(-100%); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translateX(100%); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scan-line { display: none; }
  }
</style>