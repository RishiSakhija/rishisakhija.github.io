---
/**
 * Transition Overlay - Persistent element for agent-style page transitions
 * Contains sweep line, agent nodes, and status chip
 */

const agentNames: Record<string, string> = {
  '/': 'supervisor',
  '/projects': 'builder',
  '/projects/': 'builder',
  '/research': 'analyst',
  '/blog': 'writer',
  '/about': 'archivist',
  '/stack': 'engineer',
  '/contact': 'courier',
};

const currentPath = Astro.url.pathname;
const currentAgent = agentNames[currentPath] || 'agent';
---

<div
  id="transition-overlay"
  class="transition-overlay"
  role="status"
  aria-live="polite"
  aria-label="Page transition"
  data-current-agent={currentAgent}
>
  <!-- Sweep Line with Red Leading Edge -->
  <div class="transition-sweep" aria-hidden="true"></div>

  <!-- Agent Nodes Traveling Along Sweep -->
  <div class="transition-nodes" aria-hidden="true">
    <div class="transition-node" style="top: 15%;"></div>
    <div class="transition-node" style="top: 30%;"></div>
    <div class="transition-node" style="top: 45%;"></div>
    <div class="transition-node" style="top: 60%;"></div>
    <div class="transition-node" style="top: 75%;"></div>
    <div class="transition-node" style="top: 85%;"></div>
  </div>

  <!-- Status Chip -->
  <div id="transition-status" class="transition-status" aria-atomic="true">
    <span id="transition-status-text"></span>
  </div>
</div>