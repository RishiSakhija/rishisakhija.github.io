---
import Monogram from '../ui/Monogram.astro';

const currentYear = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Monogram size="sm" letters="RS" />
      <span>Rishi Sakhija</span>
    </div>
    <p class="footer-copyright">
      {currentYear} Rishi Sakhija. Built with Astro.
    </p>
    <div class="footer-links">
      <a
        href="https://github.com/RishiSakhija"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/rishisakhija"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link"
      >
        LinkedIn
      </a>
      <a
        href="mailto:rishisakhija7@gmail.com"
        class="footer-link"
      >
        Email
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--border);
    background-color: var(--surface);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--fs-h4);
    color: var(--text);
  }

  .footer-copyright {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .footer-link {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--blue);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-link {
      transition: none;
    }
  }
</style>