---
import type { Project } from '../../data/projects';
import Chip from '../ui/Chip.astro';
import Button from '../ui/Button.astro';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
---

<article class="card reveal" style={`--delay: ${(index % 6) + 1}`} role="listitem">
  <header class="card-header">
    <h3 class="card-title">{project.title}</h3>
    <Chip variant="primary">{project.status === 'coming-soon' ? 'Coming Soon' : 'Live'}</Chip>
  </header>
  <p class="card-description">{project.description}</p>
  <div class="card-tags" role="list" aria-label="Technologies">
    {project.tags.map((tag) => (
      <Chip>{tag}</Chip>
    ))}
  </div>
  <footer class="card-footer">
    <Button
      href={project.demoUrl || '#'}
      variant="primary"
      size="sm"
      disabled={project.status === 'coming-soon'}
    >
      Live demo
    </Button>
    <Button
      href={project.codeUrl || '#'}
      variant="secondary"
      size="sm"
      disabled={project.status === 'coming-soon'}
    >
      Code
    </Button>
  </footer>
</article>