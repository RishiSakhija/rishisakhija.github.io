---
import RSLogo from './RSLogo.astro';
import Button from './Button.astro';
import { guideTopics } from '../data/guide.js';
---

<style>
  .guide-helper {
    position: fixed;
    bottom: var(--space-6);
    right: var(--space-6);
    z-index: 9990;
  }

  .guide-helper__trigger {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--text) 85%, transparent);
    background: var(--surface);
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    transition: border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    flex: none;
  }

  .guide-helper__trigger:hover {
    border-color: var(--blue-soft);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 24px var(--blue-soft);
  }

  .guide-helper__trigger:focus-visible {
    outline: 2px solid var(--blue-soft);
    outline-offset: 3px;
  }

  .guide-helper__trigger:active {
    transform: scale(0.95);
  }

  .guide-helper__trigger svg {
    width: 28px;
    height: 28px;
    stroke: var(--text);
  }

  .guide-helper__panel {
    position: absolute;
    bottom: 72px;
    right: 0;
    width: clamp(300px, 80vw, 420px);
    background: var(--surface);
    border: var(--card-border);
    border-radius: var(--radius-card);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px) scale(0.96);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 480px) {
    .guide-helper__panel {
      right: calc(-50vw + 156px);
      width: 85vw;
      max-width: 380px;
    }
  }

  .guide-helper__panel--open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .guide-helper__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border);
  }

  .guide-helper__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    color: var(--text);
  }

  .guide-helper__close {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-card);
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--muted);
    transition: background 0.15s ease, color 0.15s ease;
  }

  .guide-helper__close:hover {
    background: var(--surface-2);
    color: var(--text);
  }

  .guide-helper__close:focus-visible {
    outline: 2px solid var(--blue-soft);
    outline-offset: 2px;
  }

  .guide-helper__close svg {
    width: 18px;
    height: 18px;
  }

  .guide-helper__content {
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-height: 60vh;
    overflow-y: auto;
  }

  .guide-helper__greeting {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-fade);
  }

  .guide-helper__topics {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .guide-helper__topic-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    text-align: left;
    font-family: var(--font-body);
    font-size: 13.5px;
    color: var(--text);
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .guide-helper__topic-btn:hover {
    border-color: var(--blue);
    background: var(--surface);
  }

  .guide-helper__topic-btn:focus-visible {
    outline: 2px solid var(--blue-soft);
    outline-offset: 2px;
  }

  .guide-helper__topic-btn[aria-expanded="true"] {
    border-color: var(--blue);
    background: var(--surface);
  }

  .guide-helper__topic-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .guide-helper__topic-icon {
    width: 20px;
    height: 20px;
    stroke: var(--blue-soft);
    flex-shrink: 0;
  }

  .guide-helper__topic-chevron {
    width: 16px;
    height: 16px;
    stroke: var(--muted);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .guide-helper__topic-btn[aria-expanded="true"] .guide-helper__topic-chevron {
    transform: rotate(180deg);
  }

  .guide-helper__questions {
    display: none;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding-left: var(--space-2);
    border-left: 1px solid var(--border);
  }

  .guide-helper__questions--open {
    display: flex;
    animation: fade-in 0.2s ease;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .guide-helper__question-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-card);
    text-align: left;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-fade);
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .guide-helper__question-btn:hover {
    background: var(--surface-2);
    border-color: var(--border);
    color: var(--text);
  }

  .guide-helper__question-btn:focus-visible {
    outline: 2px solid var(--blue-soft);
    outline-offset: 2px;
  }

  .guide-helper__question-btn::before {
    content: '>';
    color: var(--blue-soft);
    flex-shrink: 0;
  }

  .guide-helper__reply {
    display: none;
    padding: var(--space-4);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-fade);
    animation: fade-in 0.3s ease;
    margin-top: var(--space-2);
  }

  .guide-helper__reply--open {
    display: block;
  }

  .guide-helper__reply-text {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .guide-helper__nav {
    display: none;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  .guide-helper__nav--open {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .guide-helper__panel,
    .guide-helper__questions,
    .guide-helper__reply {
      animation: none;
      transition: none;
    }
  }
</style>

<div class="guide-helper" id="guide-helper">
  <button
    class="guide-helper__trigger"
    aria-label="Open RS Guide"
    aria-expanded="false"
    aria-controls="guide-panel"
    id="guide-trigger"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/>
      <path d="M12 8v4l2 2"/>
      <circle cx="12" cy="16" r="1" fill="currentColor"/>
    </svg>
  </button>

  <div class="guide-helper__panel" id="guide-panel" role="dialog" aria-label="RS Guide" aria-modal="true">
    <div class="guide-helper__header">
      <div class="guide-helper__title">
        <RSLogo size={24} />
        <span>RS Guide</span>
      </div>
      <button class="guide-helper__close" aria-label="Close guide" id="guide-close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="guide-helper__content">
      <p class="guide-helper__greeting" id="guide-greeting">
        Welcome to Rishi's control room. I'm RS Guide. What would you like to explore first?
      </p>

      <div class="guide-helper__topics" role="list" aria-label="Topics">
        {guideTopics.map((topic, idx) => (
          <div>
            <button
              class="guide-helper__topic-btn"
              aria-expanded="false"
              aria-controls={`guide-questions-${topic.id}`}
              data-topic-id={topic.id}
              role="listitem"
            >
              <span class="guide-helper__topic-label">
                <svg class="guide-helper__topic-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {topic.icon}
                </svg>
                <span>{topic.title}</span>
              </span>
              <svg class="guide-helper__topic-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
            <div class="guide-helper__questions" id={`guide-questions-${topic.id}`} role="list" aria-label={`${topic.title} questions`}>
              {topic.questions.map((q, qIdx) => (
                <button
                  class="guide-helper__question-btn"
                  data-question-id={q.id}
                  data-topic-id={topic.id}
                  role="listitem"
                >
                  {q.text}
                </button>
              ))}
              <div class="guide-helper__reply" id={`guide-reply-${topic.id}`} aria-live="polite" aria-atomic="true">
                <div class="guide-helper__reply-text"></div>
              </div>
              <Button
                class="guide-helper__nav"
                variant="primary"
                href={topic.target}
                id={`guide-nav-${topic.id}`}
              >
                Take me there
              </Button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const helper = document.getElementById('guide-helper');
    if (!helper) return;

    const trigger = helper.querySelector('#guide-trigger');
    const panel = helper.querySelector('#guide-panel');
    const closeBtn = helper.querySelector('#guide-close');
    const topicBtns = helper.querySelectorAll('.guide-helper__topic-btn');
    const questionBtns = helper.querySelectorAll('.guide-helper__question-btn');
    const greeting = helper.querySelector('#guide-greeting');

    let isOpen = false;
    let activeTopic = null;
    let activeQuestion = null;
    let focusTrapElements = [];
    let lastFocused = null;

    const currentPath = window.location.pathname;

    async function getReply(topicId, questionId) {
      try {
        const mod = await import('../data/guide.js');
        return mod.getReply(topicId, questionId);
      } catch {
        return 'Data unavailable.';
      }
    }

    function typeReply(element, text) {
      element.textContent = '';
      let i = 0;
      const speed = 15;
      function tick() {
        if (i < text.length) {
          element.textContent += text[i];
          i++;
          setTimeout(tick, speed);
        }
      }
      tick();
    }

    function updateFocusTrap() {
      if (!panel) return;
      focusTrapElements = Array.from(panel.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      )).filter(el => !el.disabled && el.offsetParent !== null);
    }

    function trapFocus(e) {
      if (!isOpen || focusTrapElements.length === 0) return;
      if (e.key !== 'Tab') return;

      const first = focusTrapElements[0];
      const last = focusTrapElements[focusTrapElements.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function openPanel() {
      if (isOpen) return;
      isOpen = true;
      lastFocused = document.activeElement;
      panel.classList.add('guide-helper__panel--open');
      trigger.setAttribute('aria-expanded', 'true');
      updateFocusTrap();
      setTimeout(() => {
        const firstFocusable = focusTrapElements[0] || closeBtn;
        firstFocusable?.focus();
      }, 50);
      document.addEventListener('keydown', trapFocus);
      document.addEventListener('keydown', handleEscape);
      document.body.style.overflow = 'hidden';
    }

    function closePanel() {
      if (!isOpen) return;
      isOpen = false;
      panel.classList.remove('guide-helper__panel--open');
      trigger.setAttribute('aria-expanded', 'false');
      document.removeEventListener('keydown', trapFocus);
      document.removeEventListener('keydown', handleEscape);
      document.body.style.overflow = '';
      lastFocused?.focus();
      resetState();
    }

    function resetState() {
      topicBtns.forEach(btn => {
        btn.setAttribute('aria-expanded', 'false');
        const qId = `guide-questions-${btn.dataset.topicId}`;
        const questions = helper.querySelector('#' + qId);
        const reply = helper.querySelector('#guide-reply-' + btn.dataset.topicId);
        const nav = helper.querySelector('#guide-nav-' + btn.dataset.topicId);
        questions?.classList.remove('guide-helper__questions--open');
        reply?.classList.remove('guide-helper__reply--open');
        nav?.classList.remove('guide-helper__nav--open');
      });
      activeTopic = null;
      activeQuestion = null;
      greeting.textContent = 'Welcome to Rishi\'s control room. I\'m RS Guide. What would you like to explore first?';
    }

    function handleEscape(e) {
      if (e.key === 'Escape') {
        if (activeQuestion) {
          closeQuestion();
        } else if (activeTopic) {
          closeTopic();
        } else {
          closePanel();
        }
      }
    }

    function openTopic(topicId) {
      if (activeTopic === topicId) {
        closeTopic();
        return;
      }
      closeTopic();
      activeTopic = topicId;
      const btn = helper.querySelector(`[data-topic-id="${topicId}"]`);
      const questions = helper.querySelector(`#guide-questions-${topicId}`);
      const nav = helper.querySelector(`#guide-nav-${topicId}`);
      btn?.setAttribute('aria-expanded', 'true');
      questions?.classList.add('guide-helper__questions--open');
      nav?.classList.add('guide-helper__nav--open');
      updateFocusTrap();
      setTimeout(() => {
        const firstQ = questions?.querySelector('.guide-helper__question-btn');
        firstQ?.focus();
      }, 50);
    }

    function closeTopic() {
      if (!activeTopic) return;
      const btn = helper.querySelector(`[data-topic-id="${activeTopic}"]`);
      const questions = helper.querySelector(`#guide-questions-${activeTopic}`);
      const reply = helper.querySelector(`#guide-reply-${activeTopic}`);
      const nav = helper.querySelector(`#guide-nav-${activeTopic}`);
      btn?.setAttribute('aria-expanded', 'false');
      questions?.classList.remove('guide-helper__questions--open');
      reply?.classList.remove('guide-helper__reply--open');
      nav?.classList.remove('guide-helper__nav--open');
      activeTopic = null;
      activeQuestion = null;
      updateFocusTrap();
    }

    async function openQuestion(topicId, questionId) {
      if (activeQuestion === questionId) return;
      activeQuestion = questionId;

      const replyEl = helper.querySelector(`#guide-reply-${topicId}`);
      const replyTextEl = replyEl?.querySelector('.guide-helper__reply-text');
      if (!replyEl || !replyTextEl) return;

      replyEl.classList.add('guide-helper__reply--open');
      const replyText = await getReply(topicId, questionId);
      typeReply(replyTextEl, replyText);

      const nav = helper.querySelector(`#guide-nav-${topicId}`);
      nav?.classList.add('guide-helper__nav--open');
      updateFocusTrap();
    }

    function closeQuestion() {
      if (!activeQuestion || !activeTopic) return;
      const replyEl = helper.querySelector(`#guide-reply-${activeTopic}`);
      replyEl?.classList.remove('guide-helper__reply--open');
      activeQuestion = null;
      updateFocusTrap();
    }

    function handleClickOutside(e) {
      if (!isOpen) return;
      if (!panel.contains(e.target) && !trigger.contains(e.target)) {
        closePanel();
      }
    }

    function init() {
      trigger.addEventListener('click', () => {
        isOpen ? closePanel() : openPanel();
      });

      closeBtn.addEventListener('click', closePanel);

      topicBtns.forEach(btn => {
        btn.addEventListener('click', () => openTopic(btn.dataset.topicId));
      });

      questionBtns.forEach(btn => {
        btn.addEventListener('click', () => openQuestion(btn.dataset.topicId, btn.dataset.questionId));
      });

      document.addEventListener('click', handleClickOutside);

      const currentTopic = guideTopics.find(t => currentPath.startsWith(t.target));
      if (currentTopic) {
        setTimeout(() => openTopic(currentTopic.id), 100);
      }
    }

    function cleanup() {
      document.removeEventListener('click', handleClickOutside);
      document.removeEventListener('keydown', trapFocus);
      document.removeEventListener('keydown', handleEscape);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }

    window.addEventListener('pagehide', cleanup, { once: true });
  })();
</script>