---
interface Props {
  number: string;
  label: string;
  title: string;
  tag?: string;
  class?: string;
}

const { number, label, title, tag, class: className = '' } = Astro.props;
---

<style>
  .section-header {
    margin-bottom: 32px;
  }

  .section-header__meta {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 0;
  }

  .section-header__number {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal-soft);
    flex-shrink: 0;
  }

  .section-header__line {
    flex: 1;
    height: 1px;
    background: var(--border);
    min-width: 60px;
  }

  .section-header__label {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-strong);
    white-space: nowrap;
    padding-left: 16px;
  }

  .section-header__tag {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal-soft);
    white-space: nowrap;
    padding-left: 16px;
  }

  .section-header__title {
    font-family: var(--font-heading);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-top: 0;
  }
</style>

<header class="section-header {className}" aria-hidden="true">
  <div class="section-header__meta">
    <span class="section-header__number">{number}</span>
    <div class="section-header__line" aria-hidden="true"></div>
    <span class="section-header__label">{label}</span>
    {tag && <span class="section-header__tag">{tag}</span>}
  </div>
  <h2 class="section-header__title">{title}</h2>
</header>