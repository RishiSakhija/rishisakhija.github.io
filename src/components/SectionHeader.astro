---
interface Props {
  number: string;
  label: string;
  title: string;
  class?: string;
}

const { number, label, title, class: className = '' } = Astro.props;
---

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--heading-gap);
    margin-bottom: var(--space-6);
  }

  .section-header__meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }

  .section-header__number {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--signal);
    flex-shrink: 0;
  }

  .section-header__line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--muted), transparent);
    opacity: 0.3;
    min-width: 60px;
  }

  .section-header__label {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .section-header__title {
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
</style>

<header class="section-header {className}" aria-hidden="true">
  <div class="section-header__meta">
    <span class="section-header__number">{number}</span>
    <div class="section-header__line" aria-hidden="true"></div>
    <span class="section-header__label">{label}</span>
  </div>
  <h2 class="section-header__title">{title}</h2>
</header>