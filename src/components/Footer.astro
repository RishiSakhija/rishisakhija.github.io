        <a class="footer__logo" href="/" aria-label="Rishi Sakhija - Home">
          <RSLogo size={32} />
        </a>
        <span class="footer__name">
          <span style="color: var(--text); -webkit-text-fill-color: var(--text); background: none;">Rishi</span>Sakhija
