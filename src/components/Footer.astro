---
import RSLogo from './RSLogo.astro';
---

<style>
  .footer {
    padding: var(--space-8) 0 var(--space-6);
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .footer__wordmark {
    width: 100%;
    text-align: center;
    margin-bottom: var(--space-8);
    pointer-events: none;
  }

  .footer__wordmark-text {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(3rem, 8vw, 6rem);
    letter-spacing: -0.01em;
    color: transparent;
    -webkit-text-stroke: 1px var(--border);
    paint-order: stroke fill;
    line-height: 1.1;
  }

  @media (max-width: 767px) {
    .footer__wordmark-text {
      -webkit-text-stroke: 0.5px var(--border);
    }
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
  }

  @media (max-width: 767px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer__logo {
    display: inline-flex;
  }

  .footer__name {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    background: linear-gradient(90deg, var(--text), var(--text-fade));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 30ch;
  }

  .footer__section-title {
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-4);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__link {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text-fade);
    transition: color 0.15s ease;
  }

  .footer__link:hover {
    color: var(--signal);
  }

  .footer__link:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
    border-radius: var(--radius-card);
  }

  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__contact-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text-fade);
    transition: color 0.15s ease;
  }

  .footer__contact-item:hover {
    color: var(--signal);
  }

  .footer__contact-item:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
    border-radius: var(--radius-card);
  }

  .footer__contact-icon {
    width: 20px;
    height: 20px;
    stroke: var(--muted);
    flex-shrink: 0;
    transition: stroke 0.15s ease;
  }

  .footer__contact-item:hover .footer__contact-icon {
    stroke: var(--signal);
  }

  .footer__status {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  .footer__status-dot {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .footer__status-dot::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
  }

  .footer__back-to-top {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500.
    letter-spacing: 0.14em.
    text-transform: uppercase.
    color: var(--muted).
    transition: color 0.15s ease.
  }

  .footer__back-to-top:hover {
    color: var(--signal).
  }

  .footer__bottom {
    padding-top: var(--space-6).
    border-top: 1px solid var(--border).
    display: flex.
    flex-direction: column.
    align-items: center.
    gap: var(--space-2).
    text-align: center.
  }

  .footer__copyright {
    font-family: var(--font-body).
    font-size: 12.5px.
    font-weight: 500.
    letter-spacing: 0.14em.
    text-transform: uppercase.
    color: var(--muted).
  }

  @media (min-width: 768px) {
    .footer__bottom {
      flex-direction: row.
      justify-content: space-between.
    }
  }
</style>

<footer class="footer" role="contentinfo">
